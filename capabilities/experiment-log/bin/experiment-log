#!/usr/bin/env -S uv run --script
# /// script
# dependencies = ["PyYAML>=6.0"]
# ///

from __future__ import annotations

import argparse
import os
from pathlib import Path
import sys


REPO_ROOT = Path(__file__).resolve().parents[3]
sys.path.insert(0, str(REPO_ROOT / "scripts" / "lib" / "commands"))
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))

from agentic_state import AgenticStateError, parse_yaml_mapping, safe_load_yaml, work_branch  # noqa: E402
from command_common import CommandError, internal_request, load_request, main, print_json, project_dir_from  # noqa: E402
from experiment_log_common import (  # noqa: E402
    ExperimentLogError,
    log_correction,
    log_experiment,
    read_summary,
)


def request_from_path(path: str) -> dict[str, object]:
    if path == "-":
        return parse_yaml_mapping(sys.stdin.read(), "stdin request")
    return safe_load_yaml(Path(path))


def command_project_dir(request: dict[str, object], explicit: str | None) -> Path:
    if explicit:
        return Path(explicit).resolve()
    return Path(project_dir_from(request)).resolve()


def print_result(value: str, *, json_response: bool, payload_key: str, command: str) -> None:
    if json_response:
        print_json(
            {
                "command": command,
                "state": "ok",
                "stdout": value,
                payload_key: value,
            }
        )
    else:
        print(value)


def append_request(
    request: dict[str, object],
    *,
    project_dir: Path,
    branch_name: str | None,
    json_response: bool,
) -> None:
    if "kind" not in request:
        request = internal_request(request, "experiment_result_request")
    experiment_ref = log_experiment(request, project_dir, branch_name)
    print_result(
        experiment_ref,
        json_response=json_response,
        payload_key="experiment_id",
        command="experiment-log append",
    )


def correct_request(
    request: dict[str, object],
    *,
    project_dir: Path,
    branch_name: str | None,
    json_response: bool,
) -> None:
    if "kind" not in request:
        request = internal_request(request, "experiment_correction_request")
    correction_ref = log_correction(request, project_dir, branch_name)
    print_result(
        correction_ref,
        json_response=json_response,
        payload_key="correction_id",
        command="experiment-log correct",
    )


def add_request_args(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--request", help="YAML request file, or '-' for stdin. Defaults to stdin.")
    parser.add_argument("--project-dir", default=None)
    parser.add_argument("--work-branch", default=os.environ.get("AR_WORK_BRANCH"))


def run_append(argv: list[str]) -> None:
    parser = argparse.ArgumentParser(description="Append an Agentic Team experiment log entry.")
    add_request_args(parser)
    args = parser.parse_args(argv)

    try:
        request = request_from_path(args.request) if args.request else load_request()
        append_request(
            request,
            project_dir=command_project_dir(request, args.project_dir),
            branch_name=args.work_branch or str(request.get("work_branch") or ""),
            json_response=args.request is None,
        )
    except (AgenticStateError, ExperimentLogError) as exc:
        raise CommandError(str(exc)) from exc


def run_correct(argv: list[str]) -> None:
    parser = argparse.ArgumentParser(description="Append a correction to an Agentic Team experiment log entry.")
    add_request_args(parser)
    args = parser.parse_args(argv)

    try:
        request = request_from_path(args.request) if args.request else load_request()
        correct_request(
            request,
            project_dir=command_project_dir(request, args.project_dir),
            branch_name=args.work_branch or str(request.get("work_branch") or ""),
            json_response=args.request is None,
        )
    except (AgenticStateError, ExperimentLogError) as exc:
        raise CommandError(str(exc)) from exc


def run_summary(argv: list[str]) -> None:
    parser = argparse.ArgumentParser(description="Read the active work-branch experiment summary.")
    parser.add_argument("--project-dir", default=".")
    parser.add_argument("--work-branch", default=os.environ.get("AR_WORK_BRANCH"))
    args = parser.parse_args(argv)

    try:
        print(read_summary(Path(args.project_dir).resolve(), work_branch(args.work_branch)))
    except (AgenticStateError, ExperimentLogError) as exc:
        raise CommandError(str(exc)) from exc


def dispatch() -> None:
    command = sys.argv[1] if len(sys.argv) > 1 else ""
    args = sys.argv[2:]

    if command in {"--help", "-h", ""}:
        print("Usage: experiment-log SUBCOMMAND [OPTIONS]\n")
        print("Subcommands:")
        print("  append    Append a completed experiment result")
        print("  correct   Append a correction to an existing experiment")
        print("  summary   Read the active work-branch summary")
        if not command:
            raise CommandError("subcommand is required")
        return
    if command == "append":
        run_append(args)
    elif command == "correct":
        run_correct(args)
    elif command == "summary":
        run_summary(args)
    else:
        raise CommandError(f"unknown experiment-log subcommand: {command}")


if __name__ == "__main__":
    raise SystemExit(main(dispatch))
