#!/usr/bin/env -S uv run --script
# /// script
# dependencies = ["PyYAML>=6.0"]
# ///

"""Named command wrapper for Experiment Log structured Python tools."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys

import yaml


CAPABILITY_ROOT = Path(__file__).resolve().parents[1]
REPO_ROOT = CAPABILITY_ROOT.parents[1]
sys.path[:0] = [
    str(CAPABILITY_ROOT / "package"),
    str(REPO_ROOT / "scripts" / "package"),
]

from agentic_tools import record_data  # noqa: E402
from agentic_tools.runner import cli as tool_cli, execute  # noqa: E402


TOOLS = {
    "append": "experiment_log.tools.append:ExperimentLogAppendTool",
    "correct": "experiment_log.tools.correct:ExperimentLogCorrectTool",
    "summary": "experiment_log.tools.summary:ExperimentLogSummaryTool",
}


def _mapping(text: str) -> dict[str, object]:
    data = yaml.safe_load(text) or {}
    if not isinstance(data, dict):
        raise TypeError("request JSON/YAML must be a mapping")
    return data


def _request(path: str | None) -> dict[str, object]:
    if path and path != "-":
        return _mapping(Path(path).read_text(encoding="utf-8"))
    return _mapping(sys.stdin.read())


def _write_result(reference: str, data: dict[str, object]) -> object:
    result = execute(reference, yaml.safe_dump(data, sort_keys=False))
    print(json.dumps(record_data(result), sort_keys=True))
    return result


def _mutating_command(command: str, arguments: list[str]) -> int:
    parser = argparse.ArgumentParser(prog=f"experiment-log {command}")
    parser.add_argument("--request", help="JSON/YAML request file, or - for stdin")
    parser.add_argument("--project-dir")
    parser.add_argument("--work-branch")
    options = parser.parse_args(arguments)
    data = _request(options.request)
    if options.project_dir is not None:
        data["project_dir"] = options.project_dir
    if options.work_branch is not None:
        data["work_branch"] = options.work_branch
    _write_result(TOOLS[command], data)
    return 0


def _summary(arguments: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="experiment-log summary")
    parser.add_argument("--project-dir")
    parser.add_argument("--work-branch")
    options = parser.parse_args(arguments)
    human_mode = options.project_dir is not None or options.work_branch is not None
    data = {} if human_mode else _request(None)
    if options.project_dir is not None:
        data["project_dir"] = options.project_dir
    if options.work_branch is not None:
        data["work_branch"] = options.work_branch
    result = execute(TOOLS["summary"], yaml.safe_dump(data, sort_keys=False))
    if human_mode:
        if not result.exists:
            print(result.error or "experiment summary does not exist", file=sys.stderr)
            return 1
        print(result.content, end="" if result.content.endswith("\n") else "\n")
    else:
        print(json.dumps(record_data(result), sort_keys=True))
    return 0


def main() -> int:
    command = sys.argv[1] if len(sys.argv) > 1 else ""
    if command in {"", "-h", "--help"}:
        print("Usage: experiment-log {append|correct|summary} [--schema]")
        print("Reads a JSON or YAML mapping from stdin and writes JSON to stdout.")
        return 0 if command else 2
    reference = TOOLS.get(command)
    if reference is None:
        print(f"experiment-log: unknown subcommand: {command}", file=sys.stderr)
        return 2
    if sys.argv[2:] == ["--schema"]:
        sys.argv = [f"experiment-log {command}", reference, "--schema"]
        return tool_cli()
    try:
        if command in {"append", "correct"}:
            return _mutating_command(command, sys.argv[2:])
        return _summary(sys.argv[2:])
    except (OSError, RuntimeError, TypeError, ValueError, yaml.YAMLError) as error:
        print(f"experiment-log {command}: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
