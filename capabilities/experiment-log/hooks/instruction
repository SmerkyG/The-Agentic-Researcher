#!/bin/bash
set -euo pipefail

usage() {
    cat >&2 <<'EOF'
Usage: experiment-log CAPABILITY_COMMAND [OPTIONS]

Capability instruction hook commands:
  setup              No-op setup hook
  render-instruction Render experiment-log instructions
  post-compaction    No-op refresh hook
  refresh-loop       No-op background hook
  cleanup            No-op cleanup hook
EOF
}

parse_common() {
    project_dir=""
    branch=""
    session_id="${AR_SESSION_ID:-}"
    agent_type="${AR_MAIN_AGENT:-research-coordinator}"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --project-dir)
                project_dir="$2"
                shift 2
                ;;
            --branch)
                branch="$2"
                shift 2
                ;;
            --session-id)
                session_id="$2"
                shift 2
                ;;
            --agent-type|--cli|--output-dir|--heartbeat-dir|--interval-seconds|--stale-seconds)
                shift 2
                ;;
            *)
                echo "experiment-log capability: unknown option: $1" >&2
                return 2
                ;;
        esac
    done

    if [[ -z "$project_dir" ]]; then
        echo "experiment-log capability: --project-dir is required" >&2
        return 2
    fi
}

setup_capability() {
    parse_common "$@"
    return 0
}

render_instruction() {
    parse_common "$@"
    [[ -n "${AR_WORK_BRANCH:-}" ]] || return 0

    printf '## Experiment Log\n\n'
    printf 'When this workflow records experiments, the active work-branch experiment log lives on the project work state branch `agentic/work-state/%s` at `experiment-log/`. The log is capability-owned and may not exist until the first experiment is recorded. Use the `experiment-logger` subagent for new experiment results and the `experiment-corrector` subagent for corrections. Within this work-branch log, experiment IDs are local, such as `E0001_block-sparse-baseline`; from other work-branch logs, refer to them as `%s::E0001_block-sparse-baseline`.\n\n' "$AR_WORK_BRANCH" "$AR_WORK_BRANCH"
    printf 'Read the active work-branch experiment summary, when it exists, with:\n\n'
    printf '```bash\n'
    printf 'experiment-log --read-summary --project-dir . --work-branch %s\n' "$AR_WORK_BRANCH"
    printf '```\n\n'
}

cleanup_capability() {
    parse_common "$@"
    return 0
}

main() {
    local command="${1:-}"
    if [[ "$command" == "--help" || "$command" == "-h" ]]; then
        usage
        return 0
    fi
    if [[ -z "$command" ]]; then
        usage
        return 2
    fi
    shift

    case "$command" in
        setup)
            setup_capability "$@"
            ;;
        render-instruction)
            render_instruction "$@"
            ;;
        post-compaction|refresh-loop)
            ;;
        cleanup)
            cleanup_capability "$@"
            ;;
        *)
            usage
            return 2
            ;;
    esac
}

main "$@"
