#!/usr/bin/env -S uv run --script
# /// script
# dependencies = ["PyYAML>=6.0"]
# ///

from __future__ import annotations

import argparse
from pathlib import Path
import sys

REPO_ROOT = Path(__file__).resolve().parents[3]
sys.path.insert(0, str(REPO_ROOT / "scripts" / "lib" / "commands"))
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))

from command_common import CommandError, load_request, main, print_json
from branch_git_common import create_snapshot


HELP = """Create an explicit-path snapshot for a later branch commit.

Reads YAML from stdin.

Example:
  branch-snapshot <<'YAML'
  project_dir: .
  work_branch: work/research-main
  paths:
    - src/kernel.py
    - tests/test_kernel.py
  commit_message: "test: update kernel"
  checks:
    - "uv run pytest tests/test_kernel.py"
  check_timeout_seconds: 900
  after_commit:
    experiment_log:
      title: Kernel update
      short_description: kernel-update
      status: completed
      key_result: Tests pass.
  YAML

Required fields:
  paths           Non-empty explicit relative paths. No '.', globs, or absolute paths.
  commit_message  Commit message to use if the snapshot is later committed.

Common optional fields:
  project_dir                  Project checkout. Defaults to '.'.
  work_branch                  Active work branch. Defaults from AR_WORK_BRANCH/current branch.
  checks                       Shell commands run in the temporary commit worktree.
  check_timeout_seconds        Per-check timeout.
  after_commit.experiment_log  Experiment-log payload to finalize after commit.
"""


def normalize_request(request: dict) -> dict:
    data = dict(request)
    after_commit = data.get("after_commit")
    if isinstance(after_commit, dict):
        normalized = dict(after_commit)
        if "experiment_result_request" in normalized:
            raise CommandError("use after_commit.experiment_log, not experiment_result_request")
        data["after_commit"] = normalized
    return data


def run() -> None:
    request = normalize_request(load_request())
    result = create_snapshot(request)
    response = {"command": "branch-snapshot"}
    response.update(result)
    print_json(response)


if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        prog="branch-snapshot",
        description="Create an explicit-path snapshot for branch-commit.",
        epilog=HELP,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.parse_args()
    raise SystemExit(main(run))
