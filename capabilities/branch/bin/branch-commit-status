#!/usr/bin/env -S uv run --script
# /// script
# dependencies = ["PyYAML>=6.0"]
# ///

from __future__ import annotations

import argparse
from pathlib import Path
import sys

REPO_ROOT = Path(__file__).resolve().parents[3]
sys.path.insert(0, str(REPO_ROOT / "scripts" / "lib" / "commands"))
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))

from command_common import CommandError, load_request, main, print_json
from branch_git_common import show_status


HELP = """Read the status of a branch-commit snapshot.

Accepts a snapshot directory or status.yaml path as an optional argument.
Reads YAML from stdin when no argument is provided.

Examples:
  branch-commit-status /home/user/my-project-at/.runtime/commit-snapshots/123-research-main
  branch-commit-status /home/user/my-project-at/.runtime/commit-snapshots/123-research-main/status.yaml
  branch-commit-status <<'YAML'
  snapshot_dir: /home/user/my-project-at/.runtime/commit-snapshots/123-research-main
  YAML

Fields:
  snapshot_dir  Required. Directory returned by branch-snapshot or branch-commit.
"""


def snapshot_dir_from_path(value: str) -> Path:
    path = Path(value).expanduser().resolve()
    if path.name == "status.yaml":
        return path.parent
    return path


def run(status_target: str | None = None) -> None:
    if status_target:
        print_json(show_status(snapshot_dir_from_path(status_target)))
        return

    request = load_request()
    snapshot_dir = str(request.get("snapshot_dir") or request.get("status_path") or "").strip()
    if not snapshot_dir:
        raise CommandError("snapshot_dir or status_path is required")
    print_json(show_status(snapshot_dir_from_path(snapshot_dir)))


if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        prog="branch-commit-status",
        description="Read branch-commit status for a snapshot.",
        epilog=HELP,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("status_target", nargs="?", help="Snapshot directory or status.yaml path.")
    args = parser.parse_args()
    raise SystemExit(main(lambda: run(args.status_target)))
