#!/usr/bin/env -S uv run --script
# /// script
# dependencies = ["mcp>=1.25,<2", "PyYAML>=6.0"]
# ///

"""Bootstrap the imperative-workflows MCP server."""

from __future__ import annotations

import os
from pathlib import Path
import runpy
import sys


CAPABILITY_ROOT = Path(__file__).resolve().parents[1]
INSTALL_ROOT = CAPABILITY_ROOT.parents[1]
sys.path.insert(0, str(INSTALL_ROOT / "scripts" / "package"))
sys.path.insert(0, str(CAPABILITY_ROOT / "package"))
sys.path.insert(0, str(CAPABILITY_ROOT / "lib"))
for package_root in reversed(
    [item for item in os.environ.get("AR_WORKFLOW_PATH", "").split(os.pathsep) if item]
):
    sys.path.insert(0, package_root)

if __name__ == "__main__":
    runpy.run_module("agentic_workflows.callback_mcp", run_name="__main__")
