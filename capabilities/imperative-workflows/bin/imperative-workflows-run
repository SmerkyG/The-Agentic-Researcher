#!/usr/bin/env -S uv run --script
# /// script
# dependencies = ["PyYAML>=6.0"]
# ///

"""Bootstrap the model-free executable-workflow runner."""

from __future__ import annotations

import os
from pathlib import Path
import runpy
import sys


CAPABILITY_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(CAPABILITY_ROOT / "package"))
for package_root in reversed([item for item in os.environ.get("AR_WORKFLOW_PATH", "").split(":") if item]):
    sys.path.insert(0, package_root)

if __name__ == "__main__":
    runpy.run_module("agentic_workflows.runner", run_name="__main__")
