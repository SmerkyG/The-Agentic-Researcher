#!/usr/bin/env -S uv run --script
# /// script
# dependencies = ["PyYAML>=6.0"]
# ///

"""Commit an immutable research work-state snapshot without replacing live files."""

from __future__ import annotations

import fcntl
import os
from pathlib import Path
import subprocess
import sys
import tempfile

import yaml

sys.path.insert(0, str(Path(__file__).resolve().parents[3] / "scripts" / "lib" / "commands"))

from command_common import CommandError, load_request, main, print_json  # noqa: E402


def run_git(
    repo: Path,
    *args: str,
    env: dict[str, str] | None = None,
    input_text: str | None = None,
) -> str:
    result = subprocess.run(
        ["git", *args],
        cwd=repo,
        env=env,
        input=input_text,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if result.returncode != 0:
        detail = (result.stderr or result.stdout).strip()
        raise CommandError(f"git {' '.join(args)} failed: {detail}")
    return result.stdout.strip()


def load_manifest(snapshot_dir: Path) -> dict[str, object]:
    manifest_path = snapshot_dir / "manifest.yaml"
    if not manifest_path.is_file():
        raise CommandError(f"work-state snapshot manifest does not exist: {manifest_path}")
    data = yaml.safe_load(manifest_path.read_text(encoding="utf-8")) or {}
    if not isinstance(data, dict):
        raise CommandError(f"invalid work-state snapshot manifest: {manifest_path}")
    return data


def remote_head(repo: Path, branch: str) -> str | None:
    result = subprocess.run(
        ["git", "ls-remote", "--heads", "origin", f"refs/heads/{branch}"],
        cwd=repo,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if result.returncode != 0:
        detail = (result.stderr or result.stdout).strip()
        raise CommandError(f"git ls-remote failed: {detail}")
    line = result.stdout.strip()
    return line.split()[0] if line else None


def has_origin(repo: Path) -> bool:
    result = subprocess.run(
        ["git", "remote", "get-url", "origin"],
        cwd=repo,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    return result.returncode == 0


def update_status(snapshot_dir: Path, **values: object) -> None:
    status_path = snapshot_dir / "status.yaml"
    if status_path.exists():
        current = yaml.safe_load(status_path.read_text(encoding="utf-8")) or {}
    else:
        current = {}
    current.update(values)
    status_path.write_text(yaml.safe_dump(current, sort_keys=False), encoding="utf-8")


def commit_snapshot(snapshot_dir: Path, message: str) -> dict[str, object]:
    manifest = load_manifest(snapshot_dir)
    repo = Path(str(manifest.get("work_state_dir") or "")).expanduser().resolve()
    branch = str(manifest.get("branch") or "")
    base_commit = str(manifest.get("base_commit") or "")
    entries = manifest.get("entries")
    if not (repo / ".git").exists() or not branch or not base_commit or not isinstance(entries, list):
        raise CommandError("work-state snapshot manifest is incomplete")
    if run_git(repo, "rev-parse", f"refs/heads/{branch}") != base_commit:
        raise CommandError("work-state branch advanced after this snapshot; recapture before committing")
    if has_origin(repo):
        remote = remote_head(repo, branch)
        if remote is not None and remote != base_commit:
            raise CommandError("remote work-state branch advanced after this snapshot; refresh and recapture")

    runtime_root = snapshot_dir.parent.parent
    lock_path = runtime_root / "locks" / f"work-state-{branch.replace('/', '-')}.lock"
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    with lock_path.open("a+", encoding="utf-8") as lock_file:
        fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
        if run_git(repo, "rev-parse", f"refs/heads/{branch}") != base_commit:
            raise CommandError("work-state branch advanced while waiting for the commit lock")

        with tempfile.TemporaryDirectory(prefix="work-state-index-", dir=runtime_root) as temp_dir:
            index_path = Path(temp_dir) / "index"
            env = dict(os.environ, GIT_INDEX_FILE=str(index_path))
            run_git(repo, "read-tree", base_commit, env=env)
            for raw_entry in entries:
                if not isinstance(raw_entry, dict):
                    raise CommandError("work-state snapshot contains an invalid entry")
                relative = str(raw_entry.get("path") or "")
                if not relative:
                    raise CommandError("work-state snapshot contains an empty path")
                if bool(raw_entry.get("exists")):
                    source = snapshot_dir / "files" / relative
                    if not source.is_file():
                        raise CommandError(f"captured work-state file is missing: {relative}")
                    object_id = run_git(repo, "hash-object", "-w", "--", str(source))
                    mode = "100755" if source.stat().st_mode & 0o111 else "100644"
                    run_git(
                        repo,
                        "update-index",
                        "--add",
                        "--cacheinfo",
                        f"{mode},{object_id},{relative}",
                        env=env,
                    )
                else:
                    run_git(repo, "update-index", "--force-remove", "--", relative, env=env)
            tree = run_git(repo, "write-tree", env=env)

        base_tree = run_git(repo, "rev-parse", f"{base_commit}^{{tree}}")
        if tree == base_tree:
            update_status(snapshot_dir, state="complete", commit=base_commit, changed=False)
            return {"state": "complete", "commit": base_commit, "changed": False}

        commit = run_git(repo, "commit-tree", tree, "-p", base_commit, input_text=f"{message}\n")
        run_git(repo, "update-ref", f"refs/heads/{branch}", commit, base_commit)
        if has_origin(repo):
            run_git(repo, "push", "origin", f"{commit}:refs/heads/{branch}")

        # Refresh only the live worktree index; newer working-file edits remain untouched.
        run_git(repo, "reset", "--mixed", commit)
        update_status(snapshot_dir, state="complete", commit=commit, changed=True)
        return {"state": "complete", "commit": commit, "changed": True}


def run() -> None:
    request = load_request()
    snapshot_value = request.get("snapshot_dir")
    if not snapshot_value:
        raise CommandError("snapshot_dir is required")
    message = request.get("message", "work-state: update research records")
    if not isinstance(message, str) or not message.strip():
        raise CommandError("message must be a non-empty string")
    snapshot_dir = Path(str(snapshot_value)).expanduser().resolve()
    try:
        result = commit_snapshot(snapshot_dir, message.strip())
    except CommandError as exc:
        if snapshot_dir.is_dir():
            update_status(snapshot_dir, state="failed", error=str(exc))
        raise
    print_json({"command": "research-coordinator-work-state-commit", **result})


if __name__ == "__main__":
    raise SystemExit(main(run))
