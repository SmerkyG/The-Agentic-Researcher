#!/usr/bin/env -S uv run --script
# /// script
# dependencies = ["PyYAML>=6.0"]
# ///

"""Capture explicit work-state paths for a later immutable commit."""

from __future__ import annotations

import os
from pathlib import Path, PurePosixPath
import shutil
import subprocess
import sys
import time

import yaml

sys.path.insert(0, str(Path(__file__).resolve().parents[3] / "scripts" / "lib" / "commands"))

from command_common import CommandError, load_request, main, print_json  # noqa: E402


def git_text(repo: Path, *args: str) -> str:
    result = subprocess.run(
        ["git", *args],
        cwd=repo,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if result.returncode != 0:
        detail = (result.stderr or result.stdout).strip()
        raise CommandError(f"git {' '.join(args)} failed: {detail}")
    return result.stdout.strip()


def relative_path(value: object) -> str:
    if not isinstance(value, str) or not value.strip():
        raise CommandError("paths must contain non-empty strings")
    path = PurePosixPath(value)
    if path.is_absolute() or path == PurePosixPath(".") or ".." in path.parts:
        raise CommandError(f"work-state path must be explicit and relative: {value}")
    if any(character in value for character in "*?["):
        raise CommandError(f"work-state path must not contain a glob: {value}")
    return path.as_posix()


def runtime_root(work_state_dir: Path) -> Path:
    configured = os.environ.get("AR_RUNTIME_ROOT")
    if configured:
        return Path(configured).expanduser().resolve()
    if len(work_state_dir.parents) < 2:
        raise CommandError("AR_RUNTIME_ROOT is required for this work-state layout")
    return work_state_dir.parents[1] / ".runtime"


def run() -> None:
    request = load_request()
    work_state_value = request.get("work_state_dir") or os.environ.get("AR_WORK_STATE_DIR")
    if not work_state_value:
        raise CommandError("work_state_dir or AR_WORK_STATE_DIR is required")
    work_state_dir = Path(str(work_state_value)).expanduser().resolve()
    if not (work_state_dir / ".git").exists():
        raise CommandError(f"work-state directory is not a Git worktree: {work_state_dir}")

    raw_paths = request.get("paths")
    if not isinstance(raw_paths, list) or not raw_paths:
        raise CommandError("paths must be a non-empty list")
    paths = list(dict.fromkeys(relative_path(value) for value in raw_paths))

    branch = git_text(work_state_dir, "branch", "--show-current")
    base_commit = git_text(work_state_dir, "rev-parse", "HEAD")
    snapshot_id = f"{time.time_ns()}-{os.getpid()}"
    snapshot_dir = runtime_root(work_state_dir) / "work-state-snapshots" / snapshot_id
    files_dir = snapshot_dir / "files"
    files_dir.mkdir(parents=True)

    entries: list[dict[str, object]] = []
    for relative in paths:
        source = work_state_dir / relative
        if source.is_dir():
            raise CommandError(f"work-state snapshot paths must name files, not directories: {relative}")
        exists = source.exists()
        if exists:
            resolved = source.resolve()
            if work_state_dir not in resolved.parents:
                raise CommandError(f"work-state path escapes its worktree: {relative}")
            target = files_dir / relative
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(source, target)
        entries.append({"path": relative, "exists": exists})

    manifest = {
        "snapshot_id": snapshot_id,
        "snapshot_dir": str(snapshot_dir),
        "work_state_dir": str(work_state_dir),
        "branch": branch,
        "base_commit": base_commit,
        "paths": paths,
        "entries": entries,
    }
    manifest_path = snapshot_dir / "manifest.yaml"
    status_path = snapshot_dir / "status.yaml"
    manifest_path.write_text(yaml.safe_dump(manifest, sort_keys=False), encoding="utf-8")
    status_path.write_text(
        yaml.safe_dump({"snapshot_id": snapshot_id, "state": "captured"}, sort_keys=False),
        encoding="utf-8",
    )
    print_json(
        {
            "command": "research-coordinator-work-state-snapshot",
            "snapshot_dir": str(snapshot_dir),
            "status_path": str(status_path),
            "paths": paths,
        }
    )


if __name__ == "__main__":
    raise SystemExit(main(run))
