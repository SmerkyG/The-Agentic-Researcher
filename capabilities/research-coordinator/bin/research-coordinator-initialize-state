#!/usr/bin/env -S uv run --script
# /// script
# dependencies = ["PyYAML>=6.0"]
# ///

"""Initialize one research work branch from an approved plan."""

from __future__ import annotations

import os
from pathlib import Path
import subprocess
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[3] / "scripts" / "lib" / "commands"))

from command_common import CommandError, load_request, main, print_json  # noqa: E402


def run_git(repo: Path, *args: str, check: bool = True) -> str:
    result = subprocess.run(
        ["git", *args],
        cwd=repo,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if check and result.returncode != 0:
        detail = (result.stderr or result.stdout).strip()
        raise CommandError(f"git {' '.join(args)} failed: {detail}")
    return result.stdout.strip()


def write_if_missing(path: Path, content: str) -> bool:
    if path.exists():
        return False
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content.rstrip() + "\n", encoding="utf-8")
    return True


def run() -> None:
    request = load_request()
    plan = request.get("plan")
    if not isinstance(plan, str) or not plan.strip():
        raise CommandError("plan must be a non-empty string")
    state_value = request.get("work_state_dir") or os.environ.get("AR_WORK_STATE_DIR")
    if not state_value:
        raise CommandError("work_state_dir or AR_WORK_STATE_DIR is required")
    state = Path(str(state_value)).expanduser().resolve()
    if not (state / ".git").exists():
        raise CommandError(f"work-state directory is not a Git worktree: {state}")
    if run_git(state, "remote", "get-url", "origin", check=False):
        run_git(state, "pull", "--ff-only")

    agent_name = str(request.get("agent_name") or os.environ.get("AR_MAIN_AGENT") or "research-coordinator")
    work_branch = str(request.get("work_branch") or os.environ.get("AR_WORK_BRANCH") or "research")
    plan_path = state / "agent-notes" / agent_name / "always-injected.md"
    if plan_path.exists() and plan_path.read_text(encoding="utf-8").strip():
        raise CommandError(f"research state is already initialized: {plan_path}")

    plan_path.parent.mkdir(parents=True, exist_ok=True)
    plan_path.write_text(plan.rstrip() + "\n", encoding="utf-8")
    created = [plan_path.relative_to(state).as_posix()]
    if write_if_missing(
        state / "condensed_report.md",
        f"# Condensed Report: {work_branch}\n\nNo completed findings yet.",
    ):
        created.append("condensed_report.md")
    if write_if_missing(
        state / "report_page1.md",
        f"# Research Log: {work_branch}\n\nResearch initialized; append completed analysis sections here.",
    ):
        created.append("report_page1.md")
    if write_if_missing(state / "TODO.md", "# TODO\n\n- [ ] Run baseline evaluation"):
        created.append("TODO.md")
    (state / "images").mkdir(exist_ok=True)

    run_git(state, "add", "--", *created)
    status = subprocess.run(["git", "diff", "--cached", "--quiet"], cwd=state).returncode
    commit = run_git(state, "rev-parse", "HEAD")
    if status != 0:
        run_git(state, "commit", "-m", f"work-state: initialize {work_branch} research")
        commit = run_git(state, "rev-parse", "HEAD")
        if run_git(state, "remote", "get-url", "origin", check=False):
            branch = run_git(state, "branch", "--show-current")
            run_git(state, "push", "-u", "origin", branch)
    print_json(
        {
            "command": "research-coordinator-initialize-state",
            "commit": commit,
            "created": created,
        }
    )


if __name__ == "__main__":
    raise SystemExit(main(run))
