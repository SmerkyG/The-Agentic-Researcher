#!/usr/bin/env -S uv run --script
# /// script
# dependencies = ["PyYAML>=6.0"]
# ///

"""Named JSON/YAML wrapper for package-native research finalization tools."""

from __future__ import annotations

from pathlib import Path
import sys


CAPABILITY_ROOT = Path(__file__).resolve().parents[1]
REPO_ROOT = CAPABILITY_ROOT.parents[1]
sys.path[:0] = [
    str(CAPABILITY_ROOT / "package"),
    str(REPO_ROOT / "capabilities" / "branch" / "package"),
    str(REPO_ROOT / "scripts" / "package"),
]

from agentic_tools.runner import cli as tool_cli  # noqa: E402


TOOLS = {
    "capture": "research_finalization.tools.capture:FinalizationCaptureTool",
    "ready": "research_finalization.tools.ready:FinalizationReadyTool",
    "commit": "research_finalization.tools.commit:FinalizationRecordsCommitTool",
    "finish": "research_finalization.tools.finish:FinalizationFinishTool",
    "status": "research_finalization.tools.status:FinalizationStatusTool",
    "reconcile": "research_finalization.tools.reconcile:FinalizationReconcileTool",
}


def main() -> int:
    command = sys.argv[1] if len(sys.argv) > 1 else ""
    if command in {"", "-h", "--help"}:
        print("Usage: research-coordinator-finalization {capture|ready|commit|finish|status|reconcile}")
        print("Read JSON/YAML from stdin and write JSON.")
        return 0 if command else 2
    reference = TOOLS.get(command)
    if reference is None:
        print(f"research-coordinator-finalization: unknown subcommand: {command}", file=sys.stderr)
        return 2
    sys.argv = [f"research-coordinator-finalization {command}", reference, *sys.argv[2:]]
    return tool_cli()


if __name__ == "__main__":
    raise SystemExit(main())
