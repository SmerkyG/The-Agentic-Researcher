#!/usr/bin/env python3
"""Archive an overlong current research report page before the next write."""

from __future__ import annotations

import argparse
import os
import re
import sys
from pathlib import Path


def line_count(text: str) -> int:
    if not text:
        return 0
    return len(text.splitlines())


def next_page_path(work_state_dir: Path) -> Path:
    highest = 0
    for path in work_state_dir.glob("report_page*.md"):
        match = re.fullmatch(r"report_page(\d+)\.md", path.name)
        if match:
            highest = max(highest, int(match.group(1)))
    return work_state_dir / f"report_page{highest + 1}.md"


def report_title(text: str) -> str:
    for line in text.splitlines():
        if line.startswith("# "):
            return line.rstrip()
        if line.strip():
            break
    return "# Research Log"


def main() -> int:
    parser = argparse.ArgumentParser(
        description=(
            "If report.md in a work-state directory is over the line limit, "
            "archive it whole to the next report_pageN.md and start a fresh report.md."
        )
    )
    parser.add_argument(
        "--work-state-dir",
        default=os.environ.get("AR_WORK_STATE_DIR"),
        help="Work-state directory. Defaults to AR_WORK_STATE_DIR.",
    )
    parser.add_argument(
        "--max-lines",
        type=int,
        default=300,
        help="Archive report.md only when it has more than this many lines.",
    )
    args = parser.parse_args()

    if not args.work_state_dir:
        print("research-coordinator-report-rollover: --work-state-dir or AR_WORK_STATE_DIR is required", file=sys.stderr)
        return 2
    if args.max_lines < 1:
        print("research-coordinator-report-rollover: --max-lines must be positive", file=sys.stderr)
        return 2

    work_state_dir = Path(args.work_state_dir)
    report = work_state_dir / "report.md"
    if not report.exists():
        print(f"research-coordinator-report-rollover: {report} does not exist; no rollover needed")
        return 0

    text = report.read_text(encoding="utf-8")
    lines = line_count(text)
    if lines <= args.max_lines:
        print(f"research-coordinator-report-rollover: report.md has {lines} lines; no rollover needed")
        return 0

    destination = next_page_path(work_state_dir)
    report.rename(destination)
    report.write_text(f"{report_title(text)}\n\n", encoding="utf-8")
    print(
        "research-coordinator-report-rollover: "
        f"archived {lines}-line report.md to {destination.name}; started fresh report.md"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
