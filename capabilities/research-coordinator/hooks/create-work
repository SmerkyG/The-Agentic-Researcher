#!/bin/bash
set -euo pipefail

parent_state="${AT_CREATE_SOURCE_STATE_DIR:?AT_CREATE_SOURCE_STATE_DIR is required}"
new_state="${AT_CREATE_NEW_STATE_DIR:?AT_CREATE_NEW_STATE_DIR is required}"
work_name="${AT_CREATE_WORK_NAME:?AT_CREATE_WORK_NAME is required}"
parent_branch="${AT_CREATE_SOURCE_BRANCH:?AT_CREATE_SOURCE_BRANCH is required}"
new_branch="${AT_CREATE_NEW_BRANCH:?AT_CREATE_NEW_BRANCH is required}"

mkdir -p "$new_state/context/parent" "$new_state/images"

if [[ -f "$parent_state/report.md" && ! -e "$new_state/context/parent/report.md" ]]; then
    cp "$parent_state/report.md" "$new_state/context/parent/report.md"
fi
if [[ -f "$parent_state/TODO.md" && ! -e "$new_state/context/parent/TODO.md" ]]; then
    cp "$parent_state/TODO.md" "$new_state/context/parent/TODO.md"
fi

python - "$parent_state" "$new_state" "$work_name" "$parent_branch" "$new_branch" <<'PY'
from __future__ import annotations

from pathlib import Path
import subprocess
import sys
import yaml

parent_state = Path(sys.argv[1])
new_state = Path(sys.argv[2])
work_name = sys.argv[3]
parent_branch = sys.argv[4]
new_branch = sys.argv[5]


def git(args: list[str], cwd: Path) -> str:
    result = subprocess.run(
        ["git", *args],
        cwd=str(cwd),
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if result.returncode != 0:
        return ""
    return result.stdout.strip()


def source_work_name(branch: str) -> str:
    leaf = branch.rstrip("/").rsplit("/", 1)[-1]
    return leaf or "parent"


def selected_files(repo: Path) -> list[str]:
    if not git(["rev-parse", "--verify", "HEAD"], repo):
        return []
    output = git(["ls-tree", "-r", "--name-only", "HEAD", "--", "report.md", "TODO.md", "images"], repo)
    names = [line for line in output.splitlines() if line]
    preferred: list[str] = []
    for name in ("report.md", "TODO.md"):
        if name in names:
            preferred.append(name)
    preferred.extend(name for name in names if name not in preferred)
    return preferred


def read_parent_manifest(path: Path) -> list[dict[str, object]]:
    manifest = path / "context" / "manifest.yaml"
    if not manifest.exists():
        return []
    with manifest.open("r", encoding="utf-8") as handle:
        data = yaml.safe_load(handle) or {}
    if not isinstance(data, dict):
        return []
    references = data.get("references") or []
    if not isinstance(references, list):
        return []
    clean: list[dict[str, object]] = []
    for entry in references:
        if not isinstance(entry, dict):
            continue
        files = entry.get("files") or []
        if not isinstance(files, list):
            continue
        clean.append(
            {
                "work_name": str(entry.get("work_name") or "unknown"),
                "work_branch": str(entry.get("work_branch") or ""),
                "state_branch": str(entry.get("state_branch") or ""),
                "state_commit": str(entry.get("state_commit") or ""),
                "files": [str(item) for item in files],
            }
        )
    return clean


def merge_references(references: list[dict[str, object]]) -> list[dict[str, object]]:
    merged: dict[tuple[str, str, str], dict[str, object]] = {}
    for entry in references:
        key = (
            str(entry.get("work_branch") or ""),
            str(entry.get("state_branch") or ""),
            str(entry.get("state_commit") or ""),
        )
        if not any(key):
            continue
        existing = merged.get(key)
        if existing is None:
            existing = {
                "work_name": str(entry.get("work_name") or "unknown"),
                "work_branch": key[0],
                "state_branch": key[1],
                "state_commit": key[2],
                "files": [],
            }
            merged[key] = existing
        files = existing["files"]
        assert isinstance(files, list)
        for file_name in entry.get("files") or []:
            value = str(file_name)
            if value and value not in files:
                files.append(value)
    return list(merged.values())


context_dir = new_state / "context"
context_dir.mkdir(parents=True, exist_ok=True)

state_branch = git(["branch", "--show-current"], parent_state)
state_commit = git(["rev-parse", "--verify", "HEAD"], parent_state)
references = read_parent_manifest(parent_state)
parent_files = selected_files(parent_state)
if state_commit and parent_files:
    references.append(
        {
            "work_name": source_work_name(parent_branch),
            "work_branch": parent_branch,
            "state_branch": state_branch,
            "state_commit": state_commit,
            "files": parent_files,
        }
    )

manifest = {
    "version": 1,
    "created_from": {
        "work_name": source_work_name(parent_branch),
        "work_branch": parent_branch,
        "state_branch": state_branch,
        "state_commit": state_commit,
    },
    "references": merge_references(references),
}

with (context_dir / "manifest.yaml").open("w", encoding="utf-8") as handle:
    yaml.safe_dump(manifest, handle, sort_keys=False, allow_unicode=False)

readme_lines = [
    "# Inherited Context",
    "",
    f"This work was created from `{parent_branch}` into `{new_branch}`.",
    "",
    "The immediate parent's lightweight records are copied locally when present:",
    "",
    "- `context/parent/report.md`",
    "- `context/parent/TODO.md`",
    "",
    "All inherited report/TODO/image references are flattened in `context/manifest.yaml`.",
    "Read a referenced file with:",
    "",
    "```bash",
    'git -C "$AR_WORK_STATE_DIR" show <state_commit>:<path>',
    "```",
]

if manifest["references"]:
    readme_lines.extend(["", "## References", ""])
    for entry in manifest["references"]:
        readme_lines.append(
            f"- `{entry['work_name']}` (`{entry['work_branch']}`) "
            f"state `{entry['state_branch']}` at `{entry['state_commit']}`"
        )
        for file_name in entry["files"]:  # type: ignore[index]
            readme_lines.append(f"  - `{file_name}`")

(context_dir / "README.md").write_text("\n".join(readme_lines) + "\n", encoding="utf-8")

report = new_state / "report.md"
if not report.exists():
    report.write_text(
        f"# Research Log: {work_name}\n\n"
        f"Created from `{parent_branch}` into `{new_branch}`.\n\n"
        "## Inherited Context\n\n"
        "Read `context/README.md` first. The immediate parent's `report.md` and "
        "`TODO.md` are copied under `context/parent/` when present; larger "
        "artifacts such as images are referenced by commit in `context/manifest.yaml`.\n\n"
        f"Use this report for new analysis, derivations, figures, verification notes, "
        f"and selected result tables for `{new_branch}`.\n",
        encoding="utf-8",
    )

todo = new_state / "TODO.md"
if not todo.exists():
    todo.write_text(
        "# TODO\n\n"
        "- [ ] Read inherited context from `context/README.md`\n"
        f"- [ ] Define the first experiment for `{work_name}`\n",
        encoding="utf-8",
    )
PY

echo "Referenced inherited context in $new_state/context/manifest.yaml"
