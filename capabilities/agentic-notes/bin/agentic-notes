#!/usr/bin/env -S uv run --script
# /// script
# dependencies = ["PyYAML>=6.0"]
# ///

"""Named command wrapper for Agentic Notes tools and lifecycle messages."""

from __future__ import annotations

import argparse
import os
from pathlib import Path
import sys


CAPABILITY_ROOT = Path(__file__).resolve().parents[1]
REPO_ROOT = CAPABILITY_ROOT.parents[1]
sys.path[:0] = [
    str(CAPABILITY_ROOT / "package"),
    str(REPO_ROOT / "scripts" / "package"),
]

from agentic_notes.tools.read import AgenticNotesReadTopicTool  # noqa: E402
from agentic_tools.runner import cli as tool_cli  # noqa: E402


INTERNAL_COMMAND = CAPABILITY_ROOT / "lib" / "agentic-notes-internal"
TOOLS = {
    "update-note": "agentic_notes.tools.update:AgenticNotesUpdateTool",
    "rewrite-note": "agentic_notes.tools.rewrite:AgenticNotesRewriteTool",
}


def _read_note(arguments: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="agentic-notes read-note")
    parser.add_argument("--project-dir", default=os.environ.get("AR_PROJECT_DIR", "."))
    parser.add_argument("--agent-type", default=os.environ.get("AR_MAIN_AGENT"))
    parser.add_argument("note_name")
    options = parser.parse_args(arguments)
    result = AgenticNotesReadTopicTool(
        topic=options.note_name,
        agent_type=options.agent_type,
        project_dir=options.project_dir,
    ).execute()
    print(result.content)
    return 0


def main() -> int:
    command = sys.argv[1] if len(sys.argv) > 1 else ""
    if command in {"", "-h", "--help"}:
        print("Usage: agentic-notes {read-note|update-note|rewrite-note} [OPTIONS]")
        print("Update and rewrite read JSON/YAML from stdin and write JSON.")
        return 0 if command else 2
    if command == "steering-message":
        os.execv(str(INTERNAL_COMMAND), [str(INTERNAL_COMMAND), command, *sys.argv[2:]])
    if command == "read-note":
        try:
            return _read_note(sys.argv[2:])
        except (OSError, RuntimeError, TypeError, ValueError) as error:
            print(f"agentic-notes read-note: {error}", file=sys.stderr)
            return 1
    reference = TOOLS.get(command)
    if reference is None:
        print(f"agentic-notes: unknown subcommand: {command}", file=sys.stderr)
        return 2
    sys.argv = [f"agentic-notes {command}", reference, *sys.argv[2:]]
    return tool_cli()


if __name__ == "__main__":
    raise SystemExit(main())
