#!/usr/bin/env -S uv run --script
# /// script
# dependencies = ["PyYAML>=6.0"]
# ///

from __future__ import annotations

from pathlib import Path
import sys
import tempfile
from typing import Any

sys.path.insert(0, str(Path(__file__).resolve().parents[3] / "scripts" / "lib" / "commands"))

from command_common import CommandError, load_request, main, print_json, project_dir_from, run_command  # noqa: E402


HELP = """\
Usage: rewrite-note < request.yaml

Replace exactly one Agentic Note with complete cleaned-up Markdown. This is for
rare note-updater cleanup after the normal note-update path has added a lesson.

Request YAML:
  target:
    scope: org | project | work
    agent_type: all-agents | AGENT_TYPE
    note_name: NOTE_TOPIC
    project_id: PROJECT_ID      # required for project/work when not inferred
    work_branch: WORK_BRANCH    # required for work when not inferred
  content: |
    # Note Title

    ## Lessons

    - Terse reusable guidance.
"""


def field_value(data: dict[str, Any], name: str) -> str | None:
    value = data.get(name)
    return str(value) if value else None


def run() -> None:
    if len(sys.argv) > 1:
        if sys.argv[1] in {"--help", "-h"}:
            print(HELP.rstrip())
            return
        raise CommandError("rewrite-note accepts YAML on stdin; use --help for usage")

    request = load_request()
    target = request.get("target")
    if not isinstance(target, dict):
        raise CommandError("rewrite-note request requires target mapping")
    source = request.get("source") if isinstance(request.get("source"), dict) else {}

    scope = field_value(target, "scope")
    agent_type = field_value(target, "agent_type")
    note_name = field_value(target, "note_name")
    content = request.get("content")
    if not scope:
        raise CommandError("rewrite-note request target.scope is required")
    if not agent_type:
        raise CommandError("rewrite-note request target.agent_type is required")
    if not note_name:
        raise CommandError("rewrite-note request target.note_name is required")
    if not isinstance(content, str) or not content.strip():
        raise CommandError("rewrite-note request requires non-empty content")

    internal_command = Path(__file__).resolve().parents[1] / "lib" / "agentic-notes-internal"
    with tempfile.NamedTemporaryFile("w", encoding="utf-8", suffix=".md", delete=False) as handle:
        content_path = Path(handle.name)
        handle.write(content.rstrip() + "\n")
    try:
        command = [
            str(internal_command),
            "replace-note",
            "--scope",
            scope,
            "--note-name",
            note_name,
            "--note-file",
            str(content_path),
            "--project-dir",
            project_dir_from(request),
            "--agent-type",
            agent_type,
            "--refresh-parent",
        ]
        project_id = field_value(target, "project_id") or field_value(source, "project_id")
        if project_id:
            command.extend(["--project-id", project_id])
        work_branch = field_value(target, "work_branch") or field_value(source, "work_branch")
        if work_branch:
            command.extend(["--work-branch", work_branch])

        result = run_command(command)
    finally:
        content_path.unlink(missing_ok=True)

    output = result.stdout.strip()
    response = {"command": "rewrite-note", "state": "ok", "stdout": output}
    if output:
        response["note_rewrite"] = output.splitlines()[-1]
    print_json(response)


if __name__ == "__main__":
    raise SystemExit(main(run))
