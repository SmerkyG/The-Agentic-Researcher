"""Launcher-hook command wrapper for the package-native Agentic Notes state."""

from __future__ import annotations

from pathlib import Path
import sys


CAPABILITY_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(CAPABILITY_ROOT / "package"))

from agentic_notes.state import main  # noqa: E402


if __name__ == "__main__":
    raise SystemExit(main())
