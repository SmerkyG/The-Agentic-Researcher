#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"
NOTES_INTERNAL="$SCRIPT_DIR/../lib/agentic-notes-internal"
project_dir="${AT_PROJECT_DIR:?AT_PROJECT_DIR is required}"
agent_type="${AT_AGENT_TYPE:-research-coordinator}"
module_path="$REPO_ROOT/capabilities/agentic-notes/instruction-modules/agentic-notes.md"

if [[ -f "$module_path" ]]; then
    cat "$module_path"
    printf '\n\n'
fi
"$NOTES_INTERNAL" render-section --project-dir "$project_dir" --agent-type "$agent_type" --dynamic-only
