#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NOTES_INTERNAL="$SCRIPT_DIR/../lib/agentic-notes-internal"

"$NOTES_INTERNAL" refresh-loop \
    --project-dir "${AT_PROJECT_DIR:?AT_PROJECT_DIR is required}" \
    --heartbeat-dir "${AT_HEARTBEAT_DIR:?AT_HEARTBEAT_DIR is required}" \
    --interval-seconds "${AT_REFRESH_INTERVAL_SECONDS:-120}" \
    --stale-seconds "${AT_STALE_SECONDS:-300}"
