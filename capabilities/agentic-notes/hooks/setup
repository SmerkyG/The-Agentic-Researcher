#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NOTES_INTERNAL="$SCRIPT_DIR/../lib/agentic-notes-internal"
project_dir="${AT_PROJECT_DIR:?AT_PROJECT_DIR is required}"

is_false() {
    case "${1:-}" in
        0|false|False|FALSE|no|No|NO|off|Off|OFF)
            return 0
            ;;
    esac
    return 1
}

if [[ -n "${AR_ORG_NOTES_REPO:-}" ]]; then
    if ! "$NOTES_INTERNAL" init-org-notes --repo "$AR_ORG_NOTES_REPO" >/dev/null; then
        echo "Warning: Could not initialize org repo checkout." >&2
    fi
fi

if is_false "${AR_NOTES_AUTO_REFRESH:-true}"; then
    "$NOTES_INTERNAL" ensure-project-state --project-dir "$project_dir" --skip-pull --no-push >/dev/null
    exit 0
fi

case "${AR_NOTES_REFRESH_MODE:-periodic}" in
    foreground)
        if ! "$NOTES_INTERNAL" refresh --project-dir "$project_dir" >/dev/null; then
            echo "Warning: Could not refresh Agentic Notes checkouts." >&2
        fi
        ;;
    *)
        "$NOTES_INTERNAL" ensure-project-state --project-dir "$project_dir" --skip-pull --no-push >/dev/null
        ;;
esac
