#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NOTES_INTERNAL="$SCRIPT_DIR/../lib/agentic-notes-internal"

"$NOTES_INTERNAL" render-section \
    --project-dir "${AT_PROJECT_DIR:?AT_PROJECT_DIR is required}" \
    --agent-type "${AT_AGENT_TYPE:?AT_AGENT_TYPE is required}"
