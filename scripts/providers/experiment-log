#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
AR_NOTES_HELPER="${AR_NOTES_CLI:-$REPO_ROOT/scripts/tools/ar-notes}"

usage() {
    cat >&2 <<'EOF'
Usage: experiment-log PROVIDER_COMMAND [OPTIONS]

Provider commands:
  setup              No-op setup hook
  render-instruction Render the experiment-log instruction section
  post-compaction    No-op refresh hook
  refresh-loop       No-op background hook
  cleanup            No-op cleanup hook
EOF
}

parse_common() {
    project_dir=""
    branch=""
    session_id="${AR_SESSION_ID:-}"
    agent_type="${AR_MAIN_AGENT:-research-coordinator}"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --project-dir)
                project_dir="$2"
                shift 2
                ;;
            --branch)
                branch="$2"
                shift 2
                ;;
            --session-id)
                session_id="$2"
                shift 2
                ;;
            --agent-type|--tool|--output-dir|--heartbeat-dir|--interval-seconds|--stale-seconds)
                shift 2
                ;;
            *)
                echo "experiment-log provider: unknown option: $1" >&2
                return 2
                ;;
        esac
    done

    if [[ -z "$project_dir" ]]; then
        echo "experiment-log provider: --project-dir is required" >&2
        return 2
    fi
}

setup_provider() {
    parse_common "$@"
    return 0
}

render_instruction() {
    parse_common "$@"
    [[ "${TEST_MODE:-false}" == "true" ]] && return 0
    [[ -n "${AR_AGENT_TOPIC:-}" ]] || return 0

    printf '## Experiment Log\n\n'
    printf 'The active branch experiment log lives on the project `%s` state branch at `.agentic/topics/%s/experiment-log/`. Use the `experiment-logger` subagent for new experiment results and the `experiment-corrector` subagent for corrections. Within this branch log, experiment IDs are local, such as `E0001_block-sparse-baseline`; from other branch logs, refer to them as `%s/E0001_block-sparse-baseline`.\n\n' "${AR_AGENTIC_STATE_BRANCH:-agentic/state}" "$AR_AGENT_TOPIC" "$AR_AGENT_TOPIC"
}

cleanup_provider() {
    parse_common "$@"
    return 0
}

main() {
    local command="${1:-}"
    if [[ "$command" == "--help" || "$command" == "-h" ]]; then
        usage
        return 0
    fi
    if [[ -z "$command" ]]; then
        usage
        return 2
    fi
    shift

    case "$command" in
        setup)
            setup_provider "$@"
            ;;
        render-instruction)
            render_instruction "$@"
            ;;
        post-compaction|refresh-loop)
            ;;
        cleanup)
            cleanup_provider "$@"
            ;;
        *)
            usage
            return 2
            ;;
    esac
}

main "$@"
