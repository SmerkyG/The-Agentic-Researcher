#!/usr/bin/env -S uv run --script
# /// script
# dependencies = ["PyYAML>=6.0"]
# ///

from __future__ import annotations

from pathlib import Path

from ar_tool_common import (
    ar_notes,
    internal_request,
    load_request,
    main,
    print_json,
    project_dir_from,
    run_command,
    write_temp_request,
)


def run() -> None:
    request = load_request()
    request_path = write_temp_request(internal_request(request, "note_update_request"))
    try:
        command = [
            str(ar_notes()),
            "update-note",
            "--request",
            str(request_path),
            "--project-dir",
            project_dir_from(request),
            "--refresh-parent",
        ]
        result = run_command(command)
    finally:
        Path(request_path).unlink(missing_ok=True)

    output = result.stdout.strip()
    response = {"tool": "note-update", "state": "ok", "stdout": output}
    if output:
        response["note_update"] = output.splitlines()[-1]
    print_json(response)


if __name__ == "__main__":
    raise SystemExit(main(run))
