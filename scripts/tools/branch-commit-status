#!/usr/bin/env -S uv run --script
# /// script
# dependencies = ["PyYAML>=6.0"]
# ///

from __future__ import annotations

from pathlib import Path

from ar_tool_common import ToolError, load_request, main, print_json
from branch_git_common import show_status


def run() -> None:
    request = load_request()
    snapshot_dir = str(request.get("snapshot_dir") or "").strip()
    if not snapshot_dir:
        raise ToolError("snapshot_dir is required")
    print_json(show_status(Path(snapshot_dir).expanduser().resolve()))


if __name__ == "__main__":
    raise SystemExit(main(run))
