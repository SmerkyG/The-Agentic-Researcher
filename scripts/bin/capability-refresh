#!/bin/bash
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

project_dir="."
agent_type="${AR_MAIN_AGENT:-research-coordinator}"
cli="${AR_CLI:-codex}"
instruction_path=""

usage() {
    cat >&2 <<'EOF'
Usage: capability-refresh --project-dir PATH --agent-type NAME --cli CLI --instruction-path PATH

Refresh configured capabilities after context compaction and rewrite
the materialized instruction file for this invocation.
EOF
}

require_value() {
    local option="$1"
    local value="${2:-}"

    if [[ -z "$value" || "$value" =~ ^- ]]; then
        echo "capability-refresh: $option requires a value" >&2
        exit 2
    fi
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --help|-h)
            usage
            exit 0
            ;;
        --project-dir)
            require_value "$1" "${2:-}"
            project_dir="$2"
            shift 2
            ;;
        --agent-type)
            require_value "$1" "${2:-}"
            agent_type="$2"
            shift 2
            ;;
        --cli)
            require_value "$1" "${2:-}"
            cli="$2"
            shift 2
            ;;
        --instruction-path)
            require_value "$1" "${2:-}"
            instruction_path="$2"
            shift 2
            ;;
        *)
            echo "capability-refresh: unknown option: $1" >&2
            exit 2
            ;;
    esac
done

default_instruction_path() {
    case "$cli" in
        gemini)
            printf '%s/GEMINI.md\n' "$project_dir"
            ;;
        claude)
            printf '%s/CLAUDE.md\n' "$project_dir"
            ;;
        *)
            printf '%s/AGENTS.md\n' "$project_dir"
            ;;
    esac
}

instruction_path="${instruction_path:-$(default_instruction_path)}"
if [[ ! -f "$instruction_path" ]]; then
    echo "capability-refresh: instruction file not found: $instruction_path" >&2
    exit 1
fi

render_args=(
    "$REPO_ROOT/agentic-team"
    "--sandbox" "none"
    "--cli" "$cli"
    "--render-only"
    "--refresh-capabilities"
    "--main-agent" "$agent_type"
)
if [[ -n "${AR_PROJECT_ID:-}" ]]; then
    render_args+=("--project-id" "$AR_PROJECT_ID")
fi
if [[ -n "${AR_WORK_BRANCH:-}" ]]; then
    render_args+=("--work-branch" "$AR_WORK_BRANCH")
fi
render_args+=("$project_dir")

if output="$("${render_args[@]}" 2>&1)"; then
    [[ -n "$output" ]] && printf '%s\n' "$output"
    printf 'Agentic Team refreshed configured capabilities and rematerialized %s.\n' "$instruction_path"
else
    echo "capability-refresh: refresh render failed: $output" >&2
    exit 1
fi
