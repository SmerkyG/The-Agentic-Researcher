#!/usr/bin/env -S uv run --script
# /// script
# dependencies = ["PyYAML>=6.0"]
# ///

"""Run one package-declared capability lifecycle hook."""

from pathlib import Path
import runpy
import sys


INSTALL_ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(INSTALL_ROOT / "scripts" / "package"))

if __name__ == "__main__":
    runpy.run_module("agentic_tools.hook_runner", run_name="__main__")
