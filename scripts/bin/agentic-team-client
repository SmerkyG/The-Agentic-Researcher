#!/usr/bin/env python3
"""Run the Agentic Team external client-context dispatcher."""

from pathlib import Path
import runpy
import sys


INSTALL_ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(INSTALL_ROOT / "scripts" / "package"))

if __name__ == "__main__":
    runpy.run_module("agentic_tools.client_context", run_name="__main__")
