#!/bin/bash
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

project_dir="."
agent_type="${AR_MAIN_AGENT:-research-coordinator}"
tool="${AR_CLI_TOOL:-codex}"
instruction_path=""

usage() {
    cat >&2 <<'EOF'
Usage: provider-refresh --project-dir PATH --agent-type NAME --tool TOOL --instruction-path PATH

Refresh configured instruction providers after context compaction and rewrite
the materialized instruction file.
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --help|-h)
            usage
            exit 0
            ;;
        --project-dir)
            project_dir="$2"
            shift 2
            ;;
        --agent-type)
            agent_type="$2"
            shift 2
            ;;
        --tool)
            tool="$2"
            shift 2
            ;;
        --instruction-path)
            instruction_path="$2"
            shift 2
            ;;
        *)
            echo "provider-refresh: unknown option: $1" >&2
            exit 2
            ;;
    esac
done

provider_names() {
    local raw="${AR_INSTRUCTION_PROVIDERS:-agentic-notes,experiment-log}"
    raw="${raw//,/ }"
    local provider
    for provider in $raw; do
        [[ -n "$provider" ]] || continue
        [[ "$provider" == "none" ]] && continue
        printf '%s\n' "$provider"
    done
}

provider_path() {
    local name="$1"
    local candidate
    for candidate in \
        "${AR_STATE_ROOT:-$HOME/.cache/agentic-researcher}/repos/org-agentic-notes/providers/$name/bin/$name" \
        "${AR_STATE_ROOT:-$HOME/.cache/agentic-researcher}/repos/org-agentic-notes/providers/$name/$name" \
        "$REPO_ROOT/scripts/providers/$name"
    do
        if [[ -x "$candidate" ]]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

default_instruction_path() {
    case "$tool" in
        gemini)
            printf '%s/GEMINI.md\n' "$project_dir"
            ;;
        claude)
            printf '%s/CLAUDE.md\n' "$project_dir"
            ;;
        *)
            printf '%s/AGENTS.md\n' "$project_dir"
            ;;
    esac
}

instruction_path="${instruction_path:-$(default_instruction_path)}"
if [[ ! -f "$instruction_path" ]]; then
    echo "provider-refresh: instruction file not found: $instruction_path" >&2
    exit 1
fi

status_parts=()
provider=""
while IFS= read -r provider; do
    provider_exe="$(provider_path "$provider")" || {
        status_parts+=("$provider: unavailable")
        continue
    }
    if output="$("$provider_exe" post-compaction --project-dir "$project_dir" --agent-type "$agent_type" --tool "$tool" 2>&1)"; then
        [[ -n "$output" ]] && status_parts+=("$provider: $output") || status_parts+=("$provider: refreshed")
    else
        status_parts+=("$provider: failed: $output")
        echo "provider-refresh: provider '$provider' failed: $output" >&2
        exit 1
    fi
done < <(provider_names)

render_args=("$REPO_ROOT/agentic-researcher" "--sandbox" "none" "--tool" "$tool" "--render-only" "--main-agent" "$agent_type")
if [[ -n "${AR_PROJECT_ID:-}" ]]; then
    render_args+=("--project-id" "$AR_PROJECT_ID")
fi
if [[ -n "${AR_AGENT_BRANCH:-}" ]]; then
    render_args+=("--agent-branch" "$AR_AGENT_BRANCH")
fi
render_args+=("$project_dir")

if output="$("${render_args[@]}" 2>&1)"; then
    status_parts+=("instruction file: re-rendered")
else
    echo "provider-refresh: full instruction render failed: $output" >&2
    exit 1
fi

if [[ ${#status_parts[@]} -gt 0 ]]; then
    printf '%s\n' "${status_parts[@]}"
else
    printf 'No instruction providers configured.\n'
fi
