launch_apptainer() {
    local mode="${1:-run}"  # run or test

    local BIND_ARGS=(
        --nv
        --compat
        --no-mount home
        --home /claude-home
        "${SSH_BIND[@]}"
        --bind "$WORKSPACE_DIR:/workspace"
        --bind "$SCRIPT_DIR:$AR_RUNTIME_CONTAINER_DIR:ro"
        --bind "$UV_CACHE_DIR:/uv-cache"
        --bind "$UV_PYTHON_INSTALL_DIR:/uv-python"
        --bind "$UV_TOOL_DIR:/uv-tools"
        --bind "$CONTAINER_TMP:/tmp"
        --bind "$STATE_ROOT:$STATE_ROOT"
        "${DATASET_BINDS[@]}"
        "${EXTRA_DIR_ROOT_BIND[@]}"
        "${EXTRA_DIR_BINDS[@]}"
        --pwd /workspace
    )

    # Multi-node dispatch binds (if active)
    if [[ "$MULTI_NODE" == "true" ]]; then
        BIND_ARGS+=("${MULTI_NODE_BINDS[@]}")
    fi

    # Claude/OpenCode-specific binds
    case "$AR_CLI_TOOL" in
        claude)
            BIND_ARGS+=(
                --bind "$AR_CONFIG_STORE:/claude-home/.claude"
                --bind "$CLAUDE_JSON:/claude-home/.claude.json"
                "${RESEARCH_BINDS[@]}"
            )
            ;;
        opencode)
            if [[ -d "${OPENCODE_CONFIG_DIR:-}" ]]; then
                BIND_ARGS+=(--bind "$OPENCODE_CONFIG_DIR:/claude-home/.config/opencode")
            fi
            if [[ -d "${OPENCODE_DATA_DIR:-}" ]]; then
                BIND_ARGS+=(--bind "$OPENCODE_DATA_DIR:/claude-home/.local/share/opencode")
            fi
            if [[ -f "$SCRIPT_DIR/INSTRUCTIONS.md" ]]; then
                BIND_ARGS+=(--bind "$SCRIPT_DIR/INSTRUCTIONS.md:/claude-home/.claude/INSTRUCTIONS.md.template:ro")
            fi
            ;;
        gemini)
            if [[ -d "${GEMINI_STATE_DIR:-}" ]]; then
                BIND_ARGS+=(--bind "$GEMINI_STATE_DIR:/claude-home/.gemini")
            fi
            ;;
        codex)
            if [[ -d "${CODEX_STATE_DIR:-}" ]]; then
                BIND_ARGS+=(--bind "$CODEX_STATE_DIR:/claude-home/.codex")
            fi
            if [[ -f "$SCRIPT_DIR/INSTRUCTIONS.md" ]]; then
                BIND_ARGS+=(--bind "$SCRIPT_DIR/INSTRUCTIONS.md:/claude-home/.claude/INSTRUCTIONS.md.template:ro")
            fi
            ;;
        pi)
            # pi reads config/auth/sessions from ~/.pi/agent; bind the parent dir.
            if [[ -d "${PI_STATE_DIR:-}" ]]; then
                BIND_ARGS+=(--bind "$PI_STATE_DIR:/claude-home/.pi")
            fi
            if [[ -f "$SCRIPT_DIR/INSTRUCTIONS.md" ]]; then
                BIND_ARGS+=(--bind "$SCRIPT_DIR/INSTRUCTIONS.md:/claude-home/.claude/INSTRUCTIONS.md.template:ro")
            fi
            ;;
    esac

    # Multi-node env vars (if active)
    if [[ "$MULTI_NODE" == "true" ]]; then
        ENV_ARGS+=("${MULTI_NODE_ENV[@]}")
    fi

    if [[ "$mode" == "test" ]]; then
        BIND_ARGS+=(
            --bind "$SCRIPT_DIR/scripts/test_sandbox.sh:/test_sandbox.sh:ro"
        )
        # Pass tool info for tool-specific tests
        ENV_ARGS+=(--env "AR_CLI_TOOL=$AR_CLI_TOOL")

        apptainer exec \
            "${BIND_ARGS[@]}" \
            "${ENV_ARGS[@]}" \
            "$CONTAINER_IMAGE" \
            /bin/bash /test_sandbox.sh
    else
        "$SCRIPT_DIR/scripts/pty-wrapper.py" apptainer run \
            "${BIND_ARGS[@]}" \
            "${ENV_ARGS[@]}" \
            "$CONTAINER_IMAGE" \
            "${TOOL_ARGS[@]}"
    fi
}
launch_oci_runtime() {
    local mode="${1:-run}"
    local oci_runtime="$AR_CONTAINER_RUNTIME"
    local host_uid host_gid host_user host_group

    if ! command -v "$oci_runtime" >/dev/null 2>&1; then
        echo "Error: $oci_runtime runtime selected, but '$oci_runtime' is not installed or not on PATH."
        echo ""
        echo "Install $oci_runtime on the host, then rerun:"
        echo "  $SCRIPT_DIR/container/build.sh --runtime $oci_runtime"
        exit 1
    fi

    host_uid="$(id -u)"
    host_gid="$(id -g)"
    host_user="$(id -un)"
    host_group="$(id -gn)"

    if [[ -f "$SCRIPT_DIR/INSTRUCTIONS.md" ]]; then
        render_instruction_template "$AR_CONFIG_STORE/INSTRUCTIONS.md.template"
    fi

    local OCI_ARGS=(
        "$oci_runtime" run --rm
        --init
        -v "$WORKSPACE_DIR:/workspace"
        -v "$SCRIPT_DIR:$AR_RUNTIME_CONTAINER_DIR:ro"
        -v "$UV_CACHE_DIR:/uv-cache"
        -v "$UV_PYTHON_INSTALL_DIR:/uv-python"
        -v "$UV_TOOL_DIR:/uv-tools"
        -v "$STATE_ROOT:$STATE_ROOT"
        -v "$AR_CONFIG_STORE:/claude-home"
        -w /workspace
    )

    if [[ -t 0 && -t 1 ]]; then
        OCI_ARGS+=(-it)
    fi

    if [[ "$oci_runtime" == "podman" ]]; then
        OCI_ARGS+=(--userns keep-id)
    fi

    # Only request Docker GPU support when the host plausibly has an NVIDIA runtime.
    if [[ "$oci_runtime" == "docker" ]]; then
        case "${AR_DOCKER_GPUS:-auto}" in
            all)
                OCI_ARGS+=(--gpus all)
                ;;
            auto)
                if [[ "$(uname -s)" == "Linux" ]] && command -v nvidia-smi >/dev/null 2>&1; then
                    OCI_ARGS+=(--gpus all)
                fi
                ;;
            none)
                ;;
        esac
    fi

    # Extra bind dirs. The EXTRA_DIR_*_BIND arrays are built for Apptainer, where
    # each mount is stored as two separate array elements ("--bind" and
    # "host:container"). Skip the flag markers and pass only the spec to -v.
    for dir_bind in "${EXTRA_DIR_ROOT_BIND[@]}" "${EXTRA_DIR_BINDS[@]}"; do
        [[ -n "$dir_bind" ]] || continue
        [[ "$dir_bind" == "--bind" ]] && continue
        OCI_ARGS+=(-v "$dir_bind")
    done

    # Convert env args
    OCI_ARGS+=(
        -e "UV_CACHE_DIR=/uv-cache"
        -e "UV_PYTHON_INSTALL_DIR=/uv-python"
        -e "UV_TOOL_DIR=/uv-tools"
        -e "UV_LINK_MODE=symlink"
        -e "HF_HOME=$HF_HOME"
        -e "TRITON_CACHE_DIR=$TRITON_CACHE_DIR"
        -e "WANDB_DIR=$WANDB_DIR"
        -e "TERM=${TERM:-xterm-256color}"
        -e "HOME=/claude-home"
        -e "HOST_UID=$host_uid"
        -e "HOST_GID=$host_gid"
        -e "HOST_USER=$host_user"
        -e "HOST_GROUP=$host_group"
        -e "SANDBOX_TOOL=$AR_CLI_TOOL"
        -e "AR_CONTAINER_RUNTIME=$AR_CONTAINER_RUNTIME"
        -e "AR_RUNTIME_DIR=$(ar_runtime_env_path)"
        -e "AR_NOTES_CLI=$(ar_notes_cli_env_path)"
        -e "AR_GPU_BACKEND=${GPU_BACKEND:-none}"
        -e "AR_STATE_ROOT=$STATE_ROOT"
        -e "AR_ORG_NOTES_REPO=${AR_ORG_NOTES_REPO:-}"
        -e "AR_MAIN_AGENT=${AR_MAIN_AGENT:-research-coordinator}"
        -e "AR_USER_ID=${AR_USER_ID:-$USER}"
        -e "AR_PROJECT_ID=${AR_PROJECT_ID:-}"
        -e "AR_AGENTIC_STATE_BRANCH=${AR_AGENTIC_STATE_BRANCH:-agentic/state}"
        -e "AR_NOTES_AUTO_REFRESH=${AR_NOTES_AUTO_REFRESH:-true}"
        -e "AR_INSTRUCTIONS_TEMPLATE=$(instructions_template_env_path)"
        -e "AR_RESOLVER_GIT_NAME=${AR_RESOLVER_GIT_NAME:-}"
        -e "AR_RESOLVER_GIT_EMAIL=${AR_RESOLVER_GIT_EMAIL:-}"
        -e "AR_NOTES_GIT_NAME=${AR_NOTES_GIT_NAME:-}"
        -e "AR_NOTES_GIT_EMAIL=${AR_NOTES_GIT_EMAIL:-}"
    )

    for env_name in ANTHROPIC_API_KEY OPENAI_API_KEY GOOGLE_API_KEY GEMINI_API_KEY; do
        if [[ -n "${!env_name:-}" ]]; then
            OCI_ARGS+=(-e "${env_name}=${!env_name}")
        fi
    done

    # If AR_API_KEY_ENV names a non-standard var, forward it as ANTHROPIC_API_KEY.
    # Only in api-key mode — in oauth mode the CLI handles auth itself.
    if [[ "${AR_AUTH_MODE:-}" == "api-key" ]]; then
        local _ar_key_var="${AR_API_KEY_ENV:-ANTHROPIC_API_KEY}"
        local anthropic_key_name="ANTHROPIC_API_KEY"
        if [[ "$_ar_key_var" != "$anthropic_key_name" && -n "${!_ar_key_var:-}" && -z "${ANTHROPIC_API_KEY:-}" ]]; then
            OCI_ARGS+=("-e" "${anthropic_key_name}=${!_ar_key_var}")
        fi
    fi
    # Proxy
    if [[ -n "${AR_HTTPS_PROXY:-}" ]]; then
        OCI_ARGS+=(-e "https_proxy=$AR_HTTPS_PROXY" -e "http_proxy=${AR_HTTP_PROXY:-$AR_HTTPS_PROXY}")
    fi

    # Extra user-defined environment variables (pipe-separated KEY=VALUE pairs)
    if [[ -n "${AR_EXTRA_ENV:-}" ]]; then
        local IFS='|'
        for entry in $AR_EXTRA_ENV; do
            [[ -n "$entry" ]] && OCI_ARGS+=(-e "$entry")
        done
    fi

    # Tool-specific
    #
    # Docker Desktop on macOS does not support nested bind mounts (mounting a
    # file into a path that is already inside a bind-mounted directory).
    # Instead, copy files into $AR_CONFIG_STORE before mounting the directory.
    case "$AR_CLI_TOOL" in
        claude)
            if [[ -f "$SCRIPT_DIR/INSTRUCTIONS.md" ]]; then
                render_instruction_template "$AR_CONFIG_STORE/INSTRUCTIONS.md.template"
            fi
            OCI_ARGS+=(
                -v "$AR_CONFIG_STORE:/claude-home/.claude"
                -v "$CLAUDE_JSON:/claude-home/.claude.json"
            )
            if [[ -n "${AR_CUSTOM_ANTHROPIC_ENDPOINT:-}" && "${AR_AUTH_MODE:-}" == "api-key" ]]; then
                OCI_ARGS+=(-e "ANTHROPIC_BASE_URL=$AR_CUSTOM_ANTHROPIC_ENDPOINT")
            fi
            ;;
        opencode)
            if [[ -d "${OPENCODE_CONFIG_DIR:-}" ]]; then
                OCI_ARGS+=(-v "$OPENCODE_CONFIG_DIR:/claude-home/.config/opencode")
            fi
            if [[ -d "${OPENCODE_DATA_DIR:-}" ]]; then
                OCI_ARGS+=(-v "$OPENCODE_DATA_DIR:/claude-home/.local/share/opencode")
            fi
            if [[ -f "$SCRIPT_DIR/INSTRUCTIONS.md" ]]; then
                render_instruction_template "$AR_CONFIG_STORE/INSTRUCTIONS.md.template"
                OCI_ARGS+=(-v "$AR_CONFIG_STORE:/claude-home/.claude")
            fi
            ;;
        gemini)
            if [[ -d "${GEMINI_STATE_DIR:-}" ]]; then
                OCI_ARGS+=(-v "$GEMINI_STATE_DIR:/claude-home/.gemini")
            fi
            ;;
        codex)
            if [[ -d "${CODEX_STATE_DIR:-}" ]]; then
                OCI_ARGS+=(-v "$CODEX_STATE_DIR:/claude-home/.codex")
            fi
            if [[ -f "$SCRIPT_DIR/INSTRUCTIONS.md" ]]; then
                render_instruction_template "$AR_CONFIG_STORE/INSTRUCTIONS.md.template"
                OCI_ARGS+=(-v "$AR_CONFIG_STORE:/claude-home/.claude")
            fi
            ;;
    esac

    # SSH/git
    if [[ -d "$HOME/.ssh" ]]; then
        OCI_ARGS+=(-v "$HOME/.ssh:/claude-home/.ssh:ro")
    fi
    if [[ -f "$HOME/.gitconfig" ]]; then
        OCI_ARGS+=(-v "$HOME/.gitconfig:/claude-home/.gitconfig:ro")
    fi

    if [[ "$mode" == "test" ]]; then
        OCI_ARGS+=(--entrypoint /bin/bash)
        OCI_ARGS+=(-v "$SCRIPT_DIR/scripts/test_sandbox.sh:/test_sandbox.sh:ro")
        OCI_ARGS+=(-e "AR_CLI_TOOL=$AR_CLI_TOOL")
        "${OCI_ARGS[@]}" agentic-researcher:latest /test_sandbox.sh
    else
        "${OCI_ARGS[@]}" agentic-researcher:latest "${TOOL_ARGS[@]}"
    fi
}

