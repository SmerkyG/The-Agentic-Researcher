    echo ""
    echo "Testing container on head node..."
    apptainer exec --nv --no-mount home --home /claude-home \
        --bind "$WORKSPACE_DIR:/workspace" \
        --bind "$SCRIPT_DIR:$AR_RUNTIME_CONTAINER_DIR:ro" \
        --bind "$CONTAINER_TMP:/tmp" \
        --pwd /workspace \
        "$CONTAINER_IMAGE" \
        bash -c 'echo "  Container OK: $(python3 --version), GPUs: $(nvidia-smi -L 2>/dev/null | wc -l)"'
    echo ""
    echo "Testing dispatch to remote nodes..."
    scontrol show hostnames "$MN_NODELIST" | while read -r node; do
        [[ "$node" == "$MN_HEAD_NODE" ]] && continue
        echo -n "  $node: "
        srun --overlap --nodes=1 --ntasks=1 --nodelist="$node" \
            --gres="gpu:$MN_GPUS_PER_NODE" --cpu-bind=none \
            apptainer exec --nv --no-mount home --home /claude-home \
                --bind "$WORKSPACE_DIR:/workspace" \
                --bind "$SCRIPT_DIR:$AR_RUNTIME_CONTAINER_DIR:ro" \
                --bind "$STATE_ROOT:$STATE_ROOT" \
                --bind "$CONTAINER_TMP:/tmp" \
                --pwd /workspace \
                "$CONTAINER_IMAGE" \
                bash -c 'echo "OK - $(nvidia-smi -L 2>/dev/null | wc -l) GPUs"' \
