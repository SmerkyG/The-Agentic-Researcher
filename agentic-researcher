validate_multi_node() {
    if [[ "$MULTI_NODE" != "true" ]]; then
        return
    fi

    if [[ "$AR_CONTAINER_RUNTIME" != "apptainer" ]]; then
        echo "Error: --multi-node requires the Apptainer runtime (--runtime apptainer)."
        exit 1
    fi

    if [[ -z "${SLURM_JOB_ID:-}" ]]; then
        echo "Error: --multi-node requires an active multi-node Slurm allocation."
        echo ""
        echo "First allocate multiple nodes, e.g.:"
        echo "  get_gpu 2 2    # 2 nodes × 2 GPUs = 4 GPUs"
        echo ""
        echo "For single-node use, omit --multi-node."
        exit 1
    fi

    MN_NODELIST="${SLURM_JOB_NODELIST:-}"
    if [[ -z "$MN_NODELIST" ]]; then
        echo "Error: SLURM_JOB_NODELIST not set."
        exit 1
    fi

    MN_NUM_NODES=$(scontrol show hostnames "$MN_NODELIST" | wc -l)
    MN_HEAD_NODE=$(hostname -s)

    # Detect GPUs per node from Slurm environment/job info
    MN_GPUS_PER_NODE="${SLURM_GPUS_ON_NODE:-}"
    if [[ -z "$MN_GPUS_PER_NODE" ]]; then
        MN_GPUS_PER_NODE=$(scontrol show job "$SLURM_JOB_ID" 2>/dev/null \
            | grep -oP 'TresPerNode=gres/gpu(:[a-zA-Z0-9]+)?:\K[0-9]+' | tail -1)
    fi
    if [[ -z "$MN_GPUS_PER_NODE" ]]; then
        MN_GPUS_PER_NODE=$(nvidia-smi -L 2>/dev/null | wc -l)
    fi
    if [[ -z "$MN_GPUS_PER_NODE" || "$MN_GPUS_PER_NODE" -eq 0 ]]; then
        echo "Warning: Could not detect GPUs per node, defaulting to 4"
        MN_GPUS_PER_NODE=4
    fi
}

setup_multi_node() {
    if [[ "$MULTI_NODE" != "true" ]]; then
        return
    fi

    DISPATCH_DIR="$STATE_ROOT/dispatch-$SLURM_JOB_ID"
    mkdir -p "$DISPATCH_DIR/jobs"

    # Write dispatcher config (host paths for the dispatcher to use)
    cat > "$DISPATCH_DIR/dispatch.conf" << DISPEOF
