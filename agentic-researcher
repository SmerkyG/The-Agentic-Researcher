build_env_args() {
    ENV_ARGS=(
        --env UV_CACHE_DIR=/uv-cache
        --env UV_PYTHON_INSTALL_DIR=/uv-python
        --env UV_TOOL_DIR=/uv-tools
        --env UV_LINK_MODE=symlink
        --env "HF_HOME=$HF_HOME"
        --env "TRITON_CACHE_DIR=$TRITON_CACHE_DIR"
        --env "WANDB_DIR=$WANDB_DIR"
        --env "TERM=${TERM:-xterm-256color}"
        --env "USER=$USER"
        --env "GIT_SSH_COMMAND=$GIT_SSH_COMMAND"
        --env "AR_CONTAINER_RUNTIME=$AR_CONTAINER_RUNTIME"
        --env "AR_RUNTIME_DIR=$(ar_runtime_env_path)"
        --env "AR_NOTES_CLI=$(ar_notes_cli_env_path)"
        --env "AR_GPU_BACKEND=${GPU_BACKEND:-none}"
        --env "AR_STATE_ROOT=$STATE_ROOT"
        --env "AR_ORG_NOTES_REPO=${AR_ORG_NOTES_REPO:-}"
        --env "AR_MAIN_AGENT=${AR_MAIN_AGENT:-research-coordinator}"
        --env "AR_USER_ID=${AR_USER_ID:-$USER}"
        --env "AR_PROJECT_ID=${AR_PROJECT_ID:-}"
        --env "AR_AGENTIC_STATE_BRANCH=${AR_AGENTIC_STATE_BRANCH:-agentic/state}"
        --env "AR_NOTES_AUTO_REFRESH=${AR_NOTES_AUTO_REFRESH:-true}"
        --env "AR_INSTRUCTIONS_TEMPLATE=$(instructions_template_env_path)"
        --env "AR_RESOLVER_GIT_NAME=${AR_RESOLVER_GIT_NAME:-}"
        --env "AR_RESOLVER_GIT_EMAIL=${AR_RESOLVER_GIT_EMAIL:-}"
        --env "AR_NOTES_GIT_NAME=${AR_NOTES_GIT_NAME:-}"
        --env "AR_NOTES_GIT_EMAIL=${AR_NOTES_GIT_EMAIL:-}"
    )

    # Standard API key pass-through so CLIs can handle auth inside the container.
    for env_name in ANTHROPIC_API_KEY OPENAI_API_KEY GOOGLE_API_KEY GEMINI_API_KEY; do
        if [[ -n "${!env_name:-}" ]]; then
            ENV_ARGS+=(--env "${env_name}=${!env_name}")
        fi
    done

    # If AR_API_KEY_ENV names a non-standard var, forward it as ANTHROPIC_API_KEY.
    # Only in api-key mode — in oauth mode the CLI handles auth itself.
    if [[ "${AR_AUTH_MODE:-}" == "api-key" ]]; then
        local _ar_key_var="${AR_API_KEY_ENV:-ANTHROPIC_API_KEY}"
        local anthropic_key_name="ANTHROPIC_API_KEY"
        if [[ "$_ar_key_var" != "$anthropic_key_name" && -n "${!_ar_key_var:-}" && -z "${ANTHROPIC_API_KEY:-}" ]]; then
            ENV_ARGS+=(--env "${anthropic_key_name}=${!_ar_key_var}")
        fi
    fi

    # Proxy
    if [[ -n "${AR_HTTPS_PROXY:-}" ]]; then
        ENV_ARGS+=(--env "https_proxy=$AR_HTTPS_PROXY" --env "http_proxy=${AR_HTTP_PROXY:-$AR_HTTPS_PROXY}")
    elif [[ -n "${HTTPS_PROXY:-}" ]]; then
        ENV_ARGS+=(--env "https_proxy=$HTTPS_PROXY" --env "http_proxy=${HTTP_PROXY:-$HTTPS_PROXY}")
    fi

    # Tool-specific env vars
    case "$AR_CLI_TOOL" in
        claude)
            if [[ -n "${AR_CUSTOM_ANTHROPIC_ENDPOINT:-}" && "${AR_AUTH_MODE:-}" == "api-key" ]]; then
                ENV_ARGS+=(--env "ANTHROPIC_BASE_URL=$AR_CUSTOM_ANTHROPIC_ENDPOINT")
            fi
            ;;
        opencode)
            ENV_ARGS+=(--env "SANDBOX_TOOL=opencode")
            ;;
        gemini)
            ENV_ARGS+=(--env "SANDBOX_TOOL=gemini")
            ;;
        codex)
            ENV_ARGS+=(--env "SANDBOX_TOOL=codex")
            ;;
        pi)
            ENV_ARGS+=(--env "SANDBOX_TOOL=pi")
            ;;
    esac

    # Extra user-defined environment variables (pipe-separated KEY=VALUE pairs)
    if [[ -n "${AR_EXTRA_ENV:-}" ]]; then
        local IFS='|'
        for entry in $AR_EXTRA_ENV; do
            [[ -n "$entry" ]] && ENV_ARGS+=(--env "$entry")
        done
    fi
}
