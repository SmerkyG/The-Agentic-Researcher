start_dispatcher() {
    if [[ "$MULTI_NODE" != "true" ]]; then
        return
    fi

    echo "Starting dispatcher daemon..."
    bash "$SCRIPT_DIR/scripts/dispatcher.sh" "$DISPATCH_DIR/dispatch.conf" \
        >> "$DISPATCH_DIR/dispatcher.log" 2>&1 &
    DISPATCHER_PID=$!
    sleep 2

    if ! kill -0 "$DISPATCHER_PID" 2>/dev/null; then
        echo "Error: Dispatcher failed to start. Check $DISPATCH_DIR/dispatcher.log"
        exit 1
    fi
    echo "Dispatcher running (pid $DISPATCHER_PID)"
    echo ""
    echo "Inside the container, use 'remote-run' to dispatch to other nodes:"
    echo "  remote-run --nodes                              # List nodes"
    echo "  remote-run htc-gpuXXX -- uv run python train.py # Run on remote node"
    echo "  remote-run htc-gpuXXX --bg -- command           # Run in background"
    echo "  remote-run --status                             # Check all jobs"
    echo ""
}

cleanup_multi_node() {
    if [[ "$MULTI_NODE" != "true" ]]; then
        return
    fi
    echo ""
    echo "Shutting down dispatcher..."
    if [[ -n "${DISPATCHER_PID:-}" ]]; then
        kill "$DISPATCHER_PID" 2>/dev/null
        wait "$DISPATCHER_PID" 2>/dev/null || true
    fi
    for pid_file in "$DISPATCH_DIR/jobs"/*.pid; do
        [[ -f "$pid_file" ]] || continue
        local pid
        pid=$(cat "$pid_file")
        kill "$pid" 2>/dev/null || true
    done
    echo "Dispatch directory preserved at: $DISPATCH_DIR"
    echo "  (delete manually when done reviewing logs)"
}

test_multi_node() {
