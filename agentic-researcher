      "--project-dir",
      projectDir,
      "--role",
      roleId,
      "--tool",
      tool,
    ])
    return [refresh, generate].filter(Boolean).join("\\n") || "Agentic Notes refresh completed."
  } catch (error) {
    return \`Agentic Notes refresh failed: \${error}\`
  }
}

export default function (pi: ExtensionAPI): void {
  let pendingRefresh = false

  pi.on("session_compact", async () => {
    pendingRefresh = true
  })

  pi.on("context", async (event) => {
    if (!pendingRefresh) return
    pendingRefresh = false
    const message = \`\${refreshMessage}\n\nRefresh status: \${runRefresh()}\`
    return {
      messages: [
        ...event.messages,
        {
          role: "custom",
          customType: "agentic-researcher-compaction-refresh",
          content: message,
          display: false,
          timestamp: Date.now(),
        },
      ],
    }
  })

  pi.on("before_agent_start", async () => {
    if (!pendingRefresh) return
    pendingRefresh = false
    const message = \`\${refreshMessage}\n\nRefresh status: \${runRefresh()}\`
    return {
      message: {
        customType: "agentic-researcher-compaction-refresh",
        content: message,
        display: false,
      },
    }
  })
}
