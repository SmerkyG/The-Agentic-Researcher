AR_NOTES_GIT_NAME="${AR_NOTES_GIT_NAME:-}"
AR_NOTES_GIT_EMAIL="${AR_NOTES_GIT_EMAIL:-}"
DISPEOF

    # Multi-node bind mounts and env vars (appended to existing arrays)
    MULTI_NODE_BINDS=(
        --bind "$DISPATCH_DIR:$DISPATCH_DIR"
        --bind "$SCRIPT_DIR/scripts/remote-run:/usr/local/bin/remote-run:ro"
    )
    MULTI_NODE_ENV=(
        --env "AR_DISPATCH_DIR=$DISPATCH_DIR"
        --env "AR_GPU_BACKEND=remote-run"
        --env "AR_GPUS_PER_NODE=$MN_GPUS_PER_NODE"
        --env "AR_NUM_NODES=$MN_NUM_NODES"
        --env "AR_HEAD_NODE=$MN_HEAD_NODE"
        --env "SLURM_JOB_NODELIST=$MN_NODELIST"
    )
