            [[ -n "$entry" ]] && export "$entry"
        done
    fi
}

run_native_test() {
    local tool_cmd="$1"
    local pass_count=0
    local fail_count=0
    local warn_count=0

    native_pass() { echo "  [PASS] $1"; pass_count=$((pass_count + 1)); }
    native_fail() { echo "  [FAIL] $1"; fail_count=$((fail_count + 1)); }
    native_warn() { echo "  [WARN] $1"; warn_count=$((warn_count + 1)); }

    echo "=== Native Runtime ==="
    if [[ "$HOME" != "/claude-home" ]]; then
        native_pass "Using host HOME: $HOME"
    else
        native_warn "HOME is /claude-home; native mode normally uses the host HOME"
    fi

    if [[ -d "$WORKSPACE_DIR" ]]; then
        native_pass "Workspace exists: $WORKSPACE_DIR"
    else
        native_fail "Workspace does not exist: $WORKSPACE_DIR"
    fi

    local testfile="$WORKSPACE_DIR/.agentic_researcher_native_test_$$"
    if touch "$testfile" 2>/dev/null; then
        native_pass "Workspace is writable"
        rm -f "$testfile"
    else
        native_fail "Workspace is not writable"
    fi

    echo ""
    echo "=== CLI Tool ==="
    if command -v "$tool_cmd" >/dev/null 2>&1; then
        native_pass "$tool_cmd found ($(command -v "$tool_cmd"))"
    else
        native_fail "$tool_cmd not found on PATH"
    fi

    echo ""
    echo "=== GPU ==="
    if command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi >/dev/null 2>&1; then
        local gpu_count
        gpu_count=$(nvidia-smi -L 2>/dev/null | wc -l | tr -d ' ')
        native_pass "GPU visible via nvidia-smi ($gpu_count device(s))"
    elif command -v rocm-smi >/dev/null 2>&1 && rocm-smi >/dev/null 2>&1; then
        native_pass "GPU visible via rocm-smi"
    else
        native_warn "No local GPU visible via nvidia-smi or rocm-smi"
    fi

    echo ""
    echo "=== GPU Backend: ${GPU_BACKEND:-none} ==="
    case "${GPU_BACKEND:-none}" in
        none)
            native_pass "No external GPU backend configured"
            ;;
        cluster-run)
            if command -v cluster-run >/dev/null 2>&1 && cluster-run --help >/dev/null 2>&1; then
                native_pass "cluster-run is available"
            else
                native_fail "cluster-run is not available or not runnable"
            fi
            ;;
        remote-run)
            native_fail "remote-run backend is container/Slurm only; use --multi-node with Apptainer"
            ;;
    esac

    echo ""
    echo "=== Network (optional) ==="
    if command -v curl >/dev/null 2>&1; then
        if curl -sf --max-time 10 https://api.anthropic.com/ >/dev/null 2>&1 || \
           curl -sf --max-time 10 https://www.google.com/ >/dev/null 2>&1; then
            native_pass "Network connectivity (HTTPS)"
        else
            native_warn "No HTTPS connectivity detected"
        fi
    else
        native_warn "curl not found; skipped network check"
    fi

    echo ""
    echo "================================"
    echo "Results: $pass_count passed, $fail_count failed, $warn_count warnings"
    if [[ "$fail_count" -eq 0 ]]; then
        echo "Status: ALL REQUIRED CHECKS PASSED"
        exit 0
    fi

    echo "Status: SOME CHECKS FAILED"
    exit 1
}

launch_native() {
    local mode="${1:-run}"
    local tool_cmd
    tool_cmd="$(native_tool_command)"

    setup_native_environment

    if [[ "$mode" == "test" ]]; then
        run_native_test "$tool_cmd"
    fi

    if ! command -v "$tool_cmd" >/dev/null 2>&1; then
        echo "Error: Native runtime selected, but '$tool_cmd' is not installed or not on PATH."
        echo "Install the selected CLI tool on the host or use a container runtime."
        exit 1
    fi

    cd "$WORKSPACE_DIR"
    exec "$tool_cmd" "${TOOL_ARGS[@]}"
}

main() {
    check_install_staleness
    capture_env_overrides
    parse_arguments "$@"
    load_config
    apply_env_overrides
    apply_defaults
    validate_runtime
    validate_workspace
    validate_project_id
    validate_api_key
    resolve_gpu_backend
    resolve_optional_skills
    validate_gpu_backend
    validate_optional_skills
    validate_multi_node
    ensure_container_image
    validate_container
    setup_storage
    setup_agentic_notes_state
    setup_instruction_file
    setup_main_agent_instruction_block
    setup_skill_instruction_blocks
    setup_agentic_notes_instruction
    setup_compaction_hooks
    translate_tool_args
    setup_auth_binds
    setup_research_binds
    setup_optional_binds
    setup_multi_node
    build_env_args
    print_debug_launch

    # Tool-specific setup
    if [[ "$AR_CONTAINER_RUNTIME" != "native" && "$AR_CLI_TOOL" == "opencode" ]]; then
        setup_opencode
    fi
    setup_project_skills
    setup_project_agents

    # Display banner
    local tool_display
    case "$AR_CLI_TOOL" in
        claude)   tool_display="Claude Code" ;;
        opencode) tool_display="OpenCode" ;;
        gemini)   tool_display="Gemini CLI" ;;
        codex)    tool_display="Codex CLI" ;;
        *)        tool_display="$AR_CLI_TOOL" ;;
    esac

    local banner_width=64
    echo "╔$(printf '═%.0s' $(seq 1 $banner_width))╗"
    local title
    if [[ "${GPU_BACKEND:-none}" == "remote-run" ]]; then
        title="Agentic Researcher - $tool_display (Multi-Node)"
    elif [[ "$AR_CONTAINER_RUNTIME" == "native" ]]; then
        title="Agentic Researcher - $tool_display (Native)"
    else
        title="Agentic Researcher - $tool_display"
    fi
    local pad=$(( banner_width - ${#title} - 7 ))
    printf "║       %s%*s║\n" "$title" "$pad" ""
    echo "╚$(printf '═%.0s' $(seq 1 $banner_width))╝"
    echo ""

    if [[ "${GPU_BACKEND:-none}" == "remote-run" ]]; then
        echo "Slurm Job:      $SLURM_JOB_ID"
        echo "Nodes:          $MN_NUM_NODES ($MN_NODELIST)"
        echo "Head node:      $MN_HEAD_NODE"
        echo "GPUs/node:      $MN_GPUS_PER_NODE"
        echo "Total GPUs:     $((MN_NUM_NODES * MN_GPUS_PER_NODE))"
        echo ""
    fi

    echo "Workspace:      $WORKSPACE_DIR"
    if [[ "$AR_CONTAINER_RUNTIME" == "native" ]]; then
        echo "Sandboxed:      No (host-native; full host filesystem access)"
    else
        echo "Sandboxed:      /workspace plus AR state/runtime mounts"
    fi
    echo "GPU backend:    ${GPU_BACKEND:-none}"
    if [[ "${GPU_BACKEND:-none}" == "remote-run" ]]; then
        echo "Dispatch dir:   $DISPATCH_DIR"
    fi
    echo "UV Cache:       $UV_CACHE_DIR"

    if [[ "$YOLO_MODE" == "true" ]]; then
        echo "Mode:           YOLO (auto-approve enabled)"
    else
        echo "Mode:           Protected (manual approval required)"
    fi
    echo ""

    # Multi-node test mode
    if [[ "${GPU_BACKEND:-none}" == "remote-run" && "$TEST_MODE" == "true" ]]; then
        test_multi_node
        # test_multi_node calls exit 0
    fi

    # Multi-node: start dispatcher and register cleanup
    if [[ "${GPU_BACKEND:-none}" == "remote-run" ]]; then
        trap cleanup_multi_node EXIT
        start_dispatcher
    fi

    echo "Starting $tool_display..."
    echo "================================================================"
    echo ""

    # Launch
    if [[ "$AR_CONTAINER_RUNTIME" == "docker" || "$AR_CONTAINER_RUNTIME" == "podman" ]]; then
        if [[ "$TEST_MODE" == "true" ]]; then
            launch_oci_runtime test
        else
            launch_oci_runtime run
        fi
    elif [[ "$AR_CONTAINER_RUNTIME" == "native" ]]; then
        if [[ "$TEST_MODE" == "true" ]]; then
            launch_native test
        else
            launch_native run
        fi
    else
        if [[ "$TEST_MODE" == "true" ]]; then
            launch_apptainer test
        else
            launch_apptainer run
        fi
    fi
}

main "$@"
