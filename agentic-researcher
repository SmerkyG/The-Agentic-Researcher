        title="Agentic Researcher - $tool_display (Remote Run)"
    elif [[ "$AR_SANDBOX" == "none" ]]; then
        title="Agentic Researcher - $tool_display (No Sandbox)"
    else
        title="Agentic Researcher - $tool_display"
    fi
    local pad=$(( banner_width - ${#title} - 7 ))
    printf "║       %s%*s║\n" "$title" "$pad" ""
    echo "╚$(printf '═%.0s' $(seq 1 $banner_width))╝"
    echo ""

    if [[ "${JOB_BACKEND:-none}" == "remote-run" ]]; then
        echo "Slurm Job:      $SLURM_JOB_ID"
        echo "Nodes:          $REMOTE_RUN_NUM_NODES ($REMOTE_RUN_NODELIST)"
        echo "Head node:      $REMOTE_RUN_HEAD_NODE"
        echo "GPUs/node:      $REMOTE_RUN_GPUS_PER_NODE"
        echo "Total GPUs:     $((REMOTE_RUN_NUM_NODES * REMOTE_RUN_GPUS_PER_NODE))"
        echo ""
    fi

    echo "Workspace:      $WORKSPACE_DIR"
    if [[ "$AR_SANDBOX" == "none" ]]; then
        echo "Sandboxed:      No (sandbox none; full host filesystem access)"
    else
        echo "Sandboxed:      /workspace plus AR state/install mounts"
    fi
    echo "Job backend:    ${JOB_BACKEND:-none}"
    if [[ "${JOB_BACKEND:-none}" == "remote-run" ]]; then
        echo "Dispatch dir:   $DISPATCH_DIR"
    fi
    echo "UV Cache:       $UV_CACHE_DIR"

    if [[ "$YOLO_MODE" == "true" ]]; then
        echo "Mode:           YOLO (auto-approve enabled)"
    else
        echo "Mode:           Protected (manual approval required)"
    fi
    echo ""

    if [[ "$TEST_MODE" == "true" ]] && run_optional_skill_hooks test true; then
        exit 0
    fi

    if run_optional_skill_hooks start true; then
        trap 'run_optional_skill_hooks cleanup' EXIT
    fi

    echo "Starting $tool_display..."
    echo "================================================================"
    echo ""

    if [[ "$TEST_MODE" == "true" ]]; then
        sandbox_call_required launch test
    else
        sandbox_call_required launch run
    fi
}

