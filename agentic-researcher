#!/bin/bash
#
# agentic-researcher: Launch an AI coding agent for structured research.
# Usage: agentic-researcher [OPTIONS] [DIRECTORY] [TOOL_OPTIONS...]
# Run with --help for details.
#

set -e
SCRIPT_PATH="${BASH_SOURCE[0]}"
resolve_realpath() {
    local path="$1"
    local dir base resolved_dir

    if command -v realpath >/dev/null 2>&1; then
        realpath "$path"
        return
    fi

    if command -v python3 >/dev/null 2>&1; then
        if python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$path" 2>/dev/null; then
            return
        fi
    fi

    if [[ -d "$path" ]]; then
        (cd "$path" && pwd -P)
        return
    fi

    dir="$(dirname "$path")"
    base="$(basename "$path")"
    resolved_dir="$(cd "$dir" && pwd -P)" || return 1
    printf '%s/%s\n' "$resolved_dir" "$base"
}

if [[ -L "$SCRIPT_PATH" ]]; then
    SCRIPT_PATH="$(resolve_realpath "$SCRIPT_PATH")"
fi
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
USER=${USER:-$(whoami)}
AR_INSTALL_CONTAINER_DIR="/opt/agentic-researcher"
AR_SANDBOX_HOME="${AR_SANDBOX_HOME:-/agent-home}"
REGISTERED_CLIS=()
REGISTERED_SANDBOXES=()

LAUNCHER_LIB_DIR="$SCRIPT_DIR/scripts/lib/launcher"
source "$LAUNCHER_LIB_DIR/registry.sh"
source "$LAUNCHER_LIB_DIR/config.sh"
source "$LAUNCHER_LIB_DIR/workspace.sh"
source "$LAUNCHER_LIB_DIR/preflight.sh"
source "$LAUNCHER_LIB_DIR/instructions.sh"
source "$LAUNCHER_LIB_DIR/utils.sh"
source "$LAUNCHER_LIB_DIR/providers.sh"
source "$LAUNCHER_LIB_DIR/hooks.sh"
source "$LAUNCHER_LIB_DIR/launch-env.sh"


main() {
    local startup_start_us
    startup_start_us="$(profile_now_us)"

    profile_step "capture_env_overrides" capture_env_overrides
    profile_step "load_cli_adapters" load_cli_adapters
    profile_step "load_sandbox_adapters" load_sandbox_adapters
    profile_step "parse_arguments" parse_arguments "$@"
    profile_step "load_config" load_config
    profile_step "apply_env_overrides" apply_env_overrides
    profile_step "apply_defaults" apply_defaults
    profile_step "validate_sandbox" validate_sandbox
    profile_step "validate_workspace" validate_workspace
    profile_step "validate_cli_workspace" validate_cli_workspace
    profile_step "validate_project_id" validate_project_id
    profile_step "setup_storage" setup_storage
    trap launcher_cleanup EXIT
    profile_step "setup_agentic_notes_provider" setup_agentic_notes_provider_once
    profile_step "resolve_main_agent_metadata" resolve_main_agent_metadata
    profile_step "prepare_agent_branch" prepare_agent_branch
    if [[ "$RENDER_ONLY" != "true" ]]; then
        profile_step "validate_api_key" validate_api_key
    fi
    profile_step "resolve_optional_skills" resolve_optional_skills
    profile_step "validate_optional_skills" validate_optional_skills
    if [[ "$RENDER_ONLY" != "true" ]]; then
        profile_step "optional preflight hooks" run_optional_skill_hooks preflight
        profile_step "ensure_container_image" ensure_container_image
        profile_step "validate_container" validate_container
    fi
    profile_step "setup_instruction_providers" setup_instruction_providers
    profile_step "setup_instruction_file" setup_instruction_file
    profile_step "setup_main_agent_block" setup_main_agent_instruction_block
    profile_step "setup_branch_instruction_block" setup_branch_instruction_block
    profile_step "setup_skill_instruction_blocks" setup_skill_instruction_blocks
    if [[ "$RENDER_ONLY" != "true" ]]; then
        profile_step "setup_compaction_hooks" setup_compaction_hooks
        profile_step "translate_tool_args" translate_tool_args
        profile_step "setup_auth_binds" setup_auth_binds
        profile_step "setup_research_binds" setup_research_binds
        profile_step "setup_optional_binds" setup_optional_binds
        profile_step "optional setup hooks" run_optional_skill_hooks setup
        profile_step "build_env_args" build_env_args
        profile_step "print_debug_launch" print_debug_launch
        profile_step "cli setup_runtime" cli_call setup_runtime
    fi
    profile_step "setup_project_skills" setup_project_skills
    profile_step "setup_project_agents" setup_project_agents
    profile_step "setup_subagent_catalog" setup_subagent_catalog_instruction_block
    profile_step "setup_provider_instruction_sections" setup_provider_instruction_sections
    if [[ -n "${INSTRUCTION_TARGET:-}" ]]; then
        profile_step "normalize_instruction_file" normalize_markdown_file "$WORKSPACE_DIR/$INSTRUCTION_TARGET"
    fi
    if [[ "$RENDER_ONLY" == "true" ]]; then
        profile_elapsed "startup setup total" "$startup_start_us"
        echo "Rendered instruction file: $WORKSPACE_DIR/$INSTRUCTION_TARGET"
        exit 0
    fi
    profile_step "setup_provider_refresh_loops" setup_provider_refresh_loops
    profile_elapsed "startup setup total" "$startup_start_us"

    # Display banner
    local tool_display
    tool_display="$(cli_call_required display_name)"

    local banner_width=64
    echo "╔$(printf '═%.0s' $(seq 1 $banner_width))╗"
    local title
    if [[ "${JOB_BACKEND:-none}" == "remote-run" ]]; then
        title="Agentic Researcher - $tool_display (Remote Run)"
    elif [[ "$AR_SANDBOX" == "none" ]]; then
        title="Agentic Researcher - $tool_display (No Sandbox)"
    else
        title="Agentic Researcher - $tool_display"
    fi
    local pad=$(( banner_width - ${#title} - 7 ))
    printf "║       %s%*s║\n" "$title" "$pad" ""
    echo "╚$(printf '═%.0s' $(seq 1 $banner_width))╝"
    echo ""

    if [[ "${JOB_BACKEND:-none}" == "remote-run" ]]; then
        echo "Slurm Job:      $SLURM_JOB_ID"
        echo "Nodes:          $REMOTE_RUN_NUM_NODES ($REMOTE_RUN_NODELIST)"
        echo "Head node:      $REMOTE_RUN_HEAD_NODE"
        echo "GPUs/node:      $REMOTE_RUN_GPUS_PER_NODE"
        echo "Total GPUs:     $((REMOTE_RUN_NUM_NODES * REMOTE_RUN_GPUS_PER_NODE))"
        echo ""
    fi

    echo "Workspace:      $WORKSPACE_DIR"
    if [[ -n "${AR_AGENT_BRANCH:-}" ]]; then
        echo "Agent branch:   $AR_AGENT_BRANCH"
        echo "Current branch: ${WORKSPACE_GIT_BRANCH:-$AR_AGENT_BRANCH}"
        echo "Ownership:      ${AR_BRANCH_OWNERSHIP:-exclusive}"
    fi
    if [[ "$AR_SANDBOX" == "none" ]]; then
        echo "Sandboxed:      No (sandbox none; full host filesystem access)"
    else
        echo "Sandboxed:      /workspace plus AR state/install mounts"
    fi
    echo "Job backend:    ${JOB_BACKEND:-none}"
    if [[ "${JOB_BACKEND:-none}" == "remote-run" ]]; then
        echo "Dispatch dir:   $DISPATCH_DIR"
    fi
    echo "UV Cache:       $UV_CACHE_DIR"

    if [[ "$YOLO_MODE" == "true" ]]; then
        echo "Mode:           YOLO (auto-approve enabled)"
    else
        echo "Mode:           Protected (manual approval required)"
    fi
    echo ""

    if [[ "$TEST_MODE" == "true" ]] && run_optional_skill_hooks test true; then
        exit 0
    fi

    if run_optional_skill_hooks start true; then
        OPTIONAL_CLEANUP_ENABLED=true
    fi

    echo "Starting $tool_display..."
    echo "================================================================"
    echo ""

    if [[ "$TEST_MODE" == "true" ]]; then
        sandbox_call_required launch test
    else
        sandbox_call_required launch run
    fi
}

main "$@"
