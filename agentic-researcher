#!/bin/bash
#
# agentic-researcher: Launch an AI coding agent for structured research.
# Usage: agentic-researcher [OPTIONS] [DIRECTORY] [TOOL_OPTIONS...]
# Run with --help for details.
#

set -e
SCRIPT_PATH="${BASH_SOURCE[0]}"
resolve_realpath() {
    local path="$1"
    local dir base resolved_dir

    if command -v realpath >/dev/null 2>&1; then
        realpath "$path"
        return
    fi

    if command -v python3 >/dev/null 2>&1; then
        if python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$path" 2>/dev/null; then
            return
        fi
    fi

    if [[ -d "$path" ]]; then
        (cd "$path" && pwd -P)
        return
    fi

    dir="$(dirname "$path")"
    base="$(basename "$path")"
    resolved_dir="$(cd "$dir" && pwd -P)" || return 1
    printf '%s/%s\n' "$resolved_dir" "$base"
}

if [[ -L "$SCRIPT_PATH" ]]; then
    SCRIPT_PATH="$(resolve_realpath "$SCRIPT_PATH")"
fi
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
USER=${USER:-$(whoami)}
AR_RUNTIME_CONTAINER_DIR="/opt/agentic-researcher"

capture_env_overrides() {
    local var override_var unset_marker="__AR_UNSET__"
    local override_vars=(
        AR_CONTAINER_RUNTIME
        AR_CLI_TOOL
        AR_DEFAULT_MODEL
        AR_STATE_ROOT
        AR_EXTRA_BIND_DIRS
        AR_EXTRA_ENV
        AR_DOCKER_GPUS
        AR_GPU_BACKEND
        AR_OPTIONAL_SKILLS
        AR_ORG_NOTES_REPO
        AR_MAIN_AGENT
        AR_USER_ID
        AR_PROJECT_ID
        AR_AGENTIC_STATE_BRANCH
        AR_NOTES_AUTO_REFRESH
        AR_AUTO_BUILD
        AR_RESOLVER_GIT_NAME
        AR_RESOLVER_GIT_EMAIL
        AR_NOTES_GIT_NAME
        AR_NOTES_GIT_EMAIL
        AR_AUTH_MODE
        AR_API_PROVIDER
        AR_API_KEY_ENV
        AR_CUSTOM_ENDPOINT
        AR_CUSTOM_ANTHROPIC_ENDPOINT
        AR_HTTPS_PROXY
        AR_HTTP_PROXY
    )

    for var in "${override_vars[@]}"; do
        override_var="${var}_ENV_OVERRIDE"
        if [[ -n "${!var+x}" ]]; then
            printf -v "$override_var" '%s' "${!var}"
        else
            printf -v "$override_var" '%s' "$unset_marker"
        fi
    done
}

config_file_path() {
    printf '%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/agentic-researcher/config.sh"
}

load_config() {
    local cfg
    cfg="$(config_file_path)"
    if [[ -f "$cfg" ]]; then
        source "$cfg"
    fi
}

# Environment variables override config file values
apply_env_overrides() {
    local var override_var
    local override_vars=(
        AR_CONTAINER_RUNTIME
        AR_CLI_TOOL
        AR_DEFAULT_MODEL
        AR_STATE_ROOT
        AR_EXTRA_BIND_DIRS
        AR_EXTRA_ENV
        AR_DOCKER_GPUS
        AR_GPU_BACKEND
        AR_OPTIONAL_SKILLS
        AR_ORG_NOTES_REPO
        AR_MAIN_AGENT
        AR_USER_ID
        AR_PROJECT_ID
        AR_AGENTIC_STATE_BRANCH
        AR_NOTES_AUTO_REFRESH
        AR_AUTO_BUILD
        AR_RESOLVER_GIT_NAME
        AR_RESOLVER_GIT_EMAIL
        AR_NOTES_GIT_NAME
        AR_NOTES_GIT_EMAIL
        AR_AUTH_MODE
        AR_API_PROVIDER
        AR_API_KEY_ENV
        AR_CUSTOM_ENDPOINT
        AR_CUSTOM_ANTHROPIC_ENDPOINT
        AR_HTTPS_PROXY
        AR_HTTP_PROXY
    )

    for var in "${override_vars[@]}"; do
        override_var="${var}_ENV_OVERRIDE"
        if [[ "${!override_var:-__AR_UNSET__}" != "__AR_UNSET__" ]]; then
            printf -v "$var" '%s' "${!override_var}"
        fi
    done

    if [[ -n "${AR_CONTAINER_RUNTIME_OVERRIDE:-}" ]]; then
        AR_CONTAINER_RUNTIME="$AR_CONTAINER_RUNTIME_OVERRIDE"
    fi
    if [[ -n "${AR_GPU_BACKEND_OVERRIDE:-}" ]]; then
        AR_GPU_BACKEND="$AR_GPU_BACKEND_OVERRIDE"
    fi
    if [[ -n "${AR_OPTIONAL_SKILLS_OVERRIDE:-}" ]]; then
        if [[ -n "${AR_OPTIONAL_SKILLS:-}" ]]; then
            AR_OPTIONAL_SKILLS="$AR_OPTIONAL_SKILLS,$AR_OPTIONAL_SKILLS_OVERRIDE"
        else
            AR_OPTIONAL_SKILLS="$AR_OPTIONAL_SKILLS_OVERRIDE"
        fi
    fi
    if [[ -n "${AR_PROJECT_ID_OVERRIDE:-}" ]]; then
        AR_PROJECT_ID="$AR_PROJECT_ID_OVERRIDE"
    fi
    if [[ -n "${AR_CLI_TOOL_OVERRIDE:-}" ]]; then
        AR_CLI_TOOL="$AR_CLI_TOOL_OVERRIDE"
    fi
    if [[ -n "${AR_DEFAULT_MODEL_OVERRIDE:-}" ]]; then
        AR_DEFAULT_MODEL="$AR_DEFAULT_MODEL_OVERRIDE"
    fi
}

check_install_staleness() {
    local marker="$SCRIPT_DIR/.agentic-researcher-install"
    [[ -f "$marker" ]] || return 0

    local source_path="" install_commit=""
    while IFS='=' read -r key value; do
        case "$key" in
            source_path) source_path="$value" ;;
            install_commit) install_commit="$value" ;;
        esac
    done < "$marker"

    [[ -n "$source_path" && -n "$install_commit" && -d "$source_path/.git" ]] || return 0

    local current_commit
    current_commit="$(git -C "$source_path" rev-parse HEAD 2>/dev/null)" || return 0

    if [[ "$install_commit" != "$current_commit" ]]; then
        echo "Warning: installed version is outdated (source repo has newer commits)."
        echo "  Run: $source_path/scripts/install.sh --force"
        echo ""
    fi
}

detect_default_oci_runtime() {
    if command -v docker >/dev/null 2>&1; then
        printf '%s\n' "docker"
    elif command -v podman >/dev/null 2>&1; then
        printf '%s\n' "podman"
    else
        printf '%s\n' "docker"
    fi
}

apply_defaults() {
    if [[ -z "${AR_CONTAINER_RUNTIME:-}" ]]; then
        AR_CONTAINER_RUNTIME="$(detect_default_oci_runtime)"
        if [[ "$AR_CONTAINER_RUNTIME" == "podman" ]] && ! command -v docker >/dev/null 2>&1; then
            echo "Docker not found, falling back to Podman."
        fi
    fi
    AR_CLI_TOOL="${AR_CLI_TOOL:-claude}"
    AR_STATE_ROOT="${AR_STATE_ROOT:-$HOME/.cache/agentic-researcher}"
    AR_EXTRA_BIND_DIRS="${AR_EXTRA_BIND_DIRS:-}"
    AR_EXTRA_ENV="${AR_EXTRA_ENV:-}"
    AR_DOCKER_GPUS="${AR_DOCKER_GPUS:-auto}"
    AR_GPU_BACKEND="${AR_GPU_BACKEND:-auto}"
    AR_OPTIONAL_SKILLS="${AR_OPTIONAL_SKILLS:-}"
    AR_ORG_NOTES_REPO="${AR_ORG_NOTES_REPO:-}"
    AR_MAIN_AGENT="${AR_MAIN_AGENT:-research-coordinator}"
    AR_USER_ID="${AR_USER_ID:-$USER}"
    AR_PROJECT_ID="${AR_PROJECT_ID:-}"
    AR_AGENTIC_STATE_BRANCH="${AR_AGENTIC_STATE_BRANCH:-agentic/state}"
    AR_NOTES_AUTO_REFRESH="${AR_NOTES_AUTO_REFRESH:-true}"
    AR_AUTO_BUILD="${AR_AUTO_BUILD:-true}"

    case "$AR_CLI_TOOL" in
        claude)
            AR_AUTH_MODE="${AR_AUTH_MODE:-oauth}"
            AR_API_PROVIDER="${AR_API_PROVIDER:-anthropic}"
            AR_API_KEY_ENV="${AR_API_KEY_ENV:-ANTHROPIC_API_KEY}"
            AR_DEFAULT_MODEL="${AR_DEFAULT_MODEL:-sonnet}"
            ;;
        opencode)
            AR_AUTH_MODE="${AR_AUTH_MODE:-tool}"
            AR_API_KEY_ENV="${AR_API_KEY_ENV:-OPENAI_API_KEY}"
            ;;
        gemini)
            AR_AUTH_MODE="${AR_AUTH_MODE:-tool}"
            AR_API_KEY_ENV="${AR_API_KEY_ENV:-GEMINI_API_KEY}"
            ;;
        codex)
            AR_AUTH_MODE="${AR_AUTH_MODE:-tool}"
            AR_API_KEY_ENV="${AR_API_KEY_ENV:-OPENAI_API_KEY}"
            ;;
        pi)
            AR_AUTH_MODE="${AR_AUTH_MODE:-tool}"
            AR_API_KEY_ENV="${AR_API_KEY_ENV:-ANTHROPIC_API_KEY}"
            ;;
    esac
}
YOLO_MODE=false
TEST_MODE=false
MULTI_NODE=false
MODEL_SPECIFIED=false
DEBUG_LAUNCH=false
WORKSPACE_DIR=""
TOOL_ARGS=()
SELECTED_OPTIONAL_SKILLS=()

append_optional_skill_override() {
    local skill_name="$1"
    if [[ -n "${AR_OPTIONAL_SKILLS_OVERRIDE:-}" ]]; then
        AR_OPTIONAL_SKILLS_OVERRIDE="$AR_OPTIONAL_SKILLS_OVERRIDE,$skill_name"
    else
        AR_OPTIONAL_SKILLS_OVERRIDE="$skill_name"
    fi
}

parse_arguments() {
    while [[ $# -gt 0 ]]; do
        case $1 in
            --setup)
                shift
                exec "$SCRIPT_DIR/scripts/first-setup.sh" "$@"
                ;;
            --clean)
                shift
                exec "$SCRIPT_DIR/scripts/cleanup.sh" "$@"
                ;;
            --uninstall)
                shift
                exec "$SCRIPT_DIR/scripts/uninstall.sh" "$@"
                ;;
            --test)
                TEST_MODE=true
                shift
                ;;
            --multi-node)
                MULTI_NODE=true
                shift
                ;;
            --debug-launch)
                DEBUG_LAUNCH=true
                shift
                ;;
            --runtime)
                if [[ -z "${2:-}" || "$2" =~ ^- ]]; then
                    echo "Error: --runtime requires a value (docker|podman|apptainer|native)"
                    exit 1
                fi
                AR_CONTAINER_RUNTIME_OVERRIDE="$2"
                shift 2
                ;;
            --tool)
                if [[ -z "${2:-}" || "$2" =~ ^- ]]; then
                    echo "Error: --tool requires a value (claude|opencode|gemini|codex|pi)"
                    exit 1
                fi
                AR_CLI_TOOL_OVERRIDE="$2"
                shift 2
                ;;
            --gpu-backend)
                if [[ -z "${2:-}" || "$2" =~ ^- ]]; then
                    echo "Error: --gpu-backend requires a value (auto|none|cluster-run|remote-run)"
                    exit 1
                fi
                AR_GPU_BACKEND_OVERRIDE="$2"
                shift 2
                ;;
            --optional-skill)
                if [[ -z "${2:-}" || "$2" =~ ^- ]]; then
                    echo "Error: --optional-skill requires a value"
                    exit 1
                fi
                append_optional_skill_override "$2"
                shift 2
                ;;
            --project-id)
                if [[ -z "${2:-}" || "$2" =~ ^- ]]; then
                    echo "Error: --project-id requires a value"
                    exit 1
                fi
                AR_PROJECT_ID_OVERRIDE="$2"
                shift 2
                ;;
            --yolo)
                YOLO_MODE=true
                shift
                ;;
            --help|-h)
                show_help
                exit 0
                ;;
            --resume|-r)
                if [[ -n "${2:-}" && ! "$2" =~ ^- ]]; then
                    TOOL_ARGS+=("--resume" "$2")
                    shift 2
                else
                    TOOL_ARGS+=("--resume")
                    shift
                fi
                ;;
            --continue|-c)
                TOOL_ARGS+=("--continue")
                shift
                ;;
            --model)
                MODEL_SPECIFIED=true
                if [[ -z "${2:-}" || "$2" =~ ^- ]]; then
                    echo "Error: --model requires a value"
                    exit 1
                fi
                TOOL_ARGS+=("$1" "$2")
                shift 2
                ;;
            --context)
                if [[ -z "${2:-}" || "$2" =~ ^- ]]; then
                    echo "Error: --context requires a value"
                    exit 1
                fi
                TOOL_ARGS+=("$1" "$2")
                shift 2
                ;;
            -*)
                TOOL_ARGS+=("$1")
                shift
                ;;
            *)
                if [[ -z "$WORKSPACE_DIR" ]]; then
                    WORKSPACE_DIR="$1"
                else
                    TOOL_ARGS+=("$1")
                fi
                shift
                ;;
        esac
    done
}

show_help() {
    cat << 'EOF'
agentic-researcher: Launch an AI coding agent for autonomous research.

Usage:
  agentic-researcher [OPTIONS] [DIRECTORY] [TOOL_OPTIONS...]

Options:
  --setup             Run the optional interactive setup wizard
  --clean             Remove launcher-managed local state
  --uninstall         Remove the installed launcher and optional local state
  --runtime NAME      Runtime for this invocation (docker|podman|apptainer|native)
  --test              Quick validation of sandbox environment
  --multi-node        Enable multi-node dispatch (Apptainer + Slurm only)
  --gpu-backend NAME  GPU job backend (auto|none|cluster-run|remote-run)
  --optional-skill NAME
                      Install an optional skill from optional-skills/ (repeatable)
  --project-id ID     Override inferred project id for notes and experiment state
  --debug-launch      Print extra launcher details and enable tool startup logs where supported
  --tool TOOL         Select CLI tool (claude|opencode|gemini|codex|pi)
  --yolo              Auto-approve all permissions (Claude Code only)
  --resume [ID]       Resume a session (interactive picker, or specify ID)
  --continue, -c      Continue the most recent conversation
  --model MODEL       Override default model
  DIRECTORY           Project directory to work in (default: current directory)
  TOOL_OPTIONS        Additional options passed to the CLI tool

Examples:
  agentic-researcher --runtime native
  agentic-researcher --runtime native --gpu-backend cluster-run
  agentic-researcher --runtime apptainer --multi-node
  agentic-researcher --optional-skill cluster-run
  agentic-researcher --setup                      # Optional setup wizard
  agentic-researcher --clean                      # Interactive cleanup of local state
  agentic-researcher --uninstall                  # Remove installed launcher
  agentic-researcher --clean --yes --include-config
  agentic-researcher --test
  agentic-researcher --tool opencode --debug-launch
  agentic-researcher                         # Current directory
  agentic-researcher ~/my-project
  agentic-researcher --yolo
  agentic-researcher --tool gemini
  agentic-researcher --tool codex ~/project
  agentic-researcher --yolo --model opus
  agentic-researcher --runtime apptainer --multi-node
  agentic-researcher --runtime apptainer --multi-node --test

What's Sandboxed:
  The agent can write your project directory and AR_STATE_ROOT.
  The AR runtime is mounted read-only at /opt/agentic-researcher.
  Cannot access the rest of your home directory, except selected auth/config mounts.
  Even with --yolo, the agent stays sandboxed.

